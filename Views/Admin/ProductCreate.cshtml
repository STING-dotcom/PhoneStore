@using PhoneStore.Models
@model Product
@{
    ViewData["Title"] = "Thêm Sản phẩm";
    Layout = "_Layout";
}

<div class="mb-3">
    <a asp-action="Products" class="text-decoration-none" style="color: #60a5fa; font-size: 0.85rem;"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
</div>

<h1 class="fw-bold mb-4" style="font-size: 1.3rem; background: linear-gradient(135deg, #ff6a00, #ee0979); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
    <i class="fa-solid fa-plus-circle me-2"></i>Thêm Sản phẩm mới
</h1>

<div style="max-width: 600px;">
    <form asp-action="ProductCreate" method="post" style="background: rgba(13,17,28,0.8); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 28px;">
        <div class="mb-3">
            <label class="form-label text-white-50 fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control bg-dark text-white border-secondary" style="border-radius: 10px; padding: 10px 14px;" />
            <span asp-validation-for="Name" class="text-danger" style="font-size: 0.78rem;"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label class="form-label text-white-50 fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Hãng</label>
                <input asp-for="Brand" class="form-control bg-dark text-white border-secondary" style="border-radius: 10px; padding: 10px 14px;" />
            </div>
            <div class="col-6">
                <label class="form-label text-white-50 fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Giá (VND)</label>
                <input asp-for="Price" class="form-control bg-dark text-white border-secondary" style="border-radius: 10px; padding: 10px 14px;" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label text-white-50 fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">URL ảnh</label>
            <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" style="border-radius: 10px; padding: 10px 14px;" />
        </div>
        <div class="mb-3">
            <label class="form-label text-white-50 fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Mô tả</label>
            <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3" style="border-radius: 10px; padding: 10px 14px;"></textarea>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="form-check">
                    <input asp-for="IsNew" class="form-check-input" />
                    <label class="form-check-label text-white-50" style="font-size: 0.85rem;">Sản phẩm mới</label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    <input asp-for="IsBestSeller" class="form-check-input" />
                    <label class="form-check-label text-white-50" style="font-size: 0.85rem;">Bán chạy</label>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label text-white-50 fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Source URL</label>
            <input asp-for="SourceUrl" class="form-control bg-dark text-white border-secondary" style="border-radius: 10px; padding: 10px 14px;" />
        </div>
        <button type="submit" class="btn text-white fw-bold w-100" style="background: linear-gradient(135deg, #ff6a00, #ee0979); border: none; border-radius: 12px; padding: 12px;">
            <i class="fa-solid fa-save me-1"></i> Lưu sản phẩm
        </button>
    </form>
</div>
