@using PhoneStore.Models
@model List<User>
@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "_Layout";
    var searchTerm = Context.Request.Query["search"].ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="fw-bold" style="font-size: 1.4rem; background: linear-gradient(135deg, #ff6a00, #ee0979); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            <i class="fa-solid fa-users me-2"></i>Người dùng
        </h1>
        <p class="text-white-50 m-0" style="font-size: 0.82rem;">Danh sách tài khoản đã đăng ký — dữ liệu tồn tại vĩnh viễn trong database</p>
    </div>
    <span class="badge" style="background:rgba(16,185,129,0.12);color:#34d399;border:1px solid rgba(16,185,129,0.2);padding:6px 14px;border-radius:8px;font-size:0.78rem;">
        <i class="fa-solid fa-database me-1"></i> @Model.Count tài khoản
    </span>
</div>


<!-- Search -->
<form method="get" action="@Url.Action("Users")" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" class="form-control" value="@searchTerm"
               placeholder="Tìm kiếm người dùng theo tên, email, SĐT..." autocomplete="off"
               style="background: rgba(15,23,42,0.8); border: 1px solid rgba(59,130,246,0.3); color: #f1f5f9; border-radius: 10px 0 0 10px; padding: 10px 14px;" />
        <button type="submit" class="btn" style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; font-weight: 700; border-radius: 0 10px 10px 0; padding: 0 20px; border: none;">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Tra
        </button>
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <a href="@Url.Action("Users")" class="btn" style="background: rgba(239,68,68,0.15); color: #ef4444; border-radius: 10px; padding: 0 14px; border: none; margin-left: 6px; font-weight: 700; font-size: 0.82rem;">
                <i class="fa-solid fa-xmark"></i> Xoá
            </a>
        }
    </div>
</form>

<div style="overflow-x: auto; border-radius: 14px; border: 1px solid rgba(255,255,255,0.06);">
    <table class="table table-dark table-hover m-0" style="background: #0a0e18; font-size: 0.82rem; min-width: 800px;">
        <thead>
            <tr style="background: rgba(255,106,0,0.08); border-bottom: 2px solid rgba(255,106,0,0.2);">
                <th class="py-3 px-3" style="color: #ff6a00;">ID</th>
                <th class="py-3" style="color: #ff6a00;">Họ tên</th>
                <th class="py-3" style="color: #ff6a00;">Email</th>
                <th class="py-3" style="color: #ff6a00;">SĐT</th>
                <th class="py-3" style="color: #ff6a00;">Vai trò</th>
                <th class="py-3" style="color: #ff6a00;">Trạng thái</th>
                <th class="py-3" style="color: #ff6a00;">Ngày tạo</th>
                <th class="py-3 text-end px-3" style="color: #ff6a00;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; @(u.IsActive ? "" : "opacity:0.6;")">
                    <td class="px-3 py-3" style="color: #64748b;">#@u.Id</td>
                    <td class="py-3 fw-semibold">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(u.AvatarUrl))
                            {
                                <img src="@u.AvatarUrl" alt="" class="rounded-circle" style="width:26px;height:26px;object-fit:cover;border:1px solid rgba(255,255,255,0.08);" />
                            }
                            <span>@u.FullName</span>
                        </div>
                    </td>
                    <td class="py-3" style="color: #94a3b8;">@u.Email</td>
                    <td class="py-3">@(string.IsNullOrEmpty(u.Phone) ? "—" : u.Phone)</td>
                    <td class="py-3">
                        @if (u.Role == "Admin")
                        {
                            <span class="badge" style="background: rgba(255,106,0,0.15); color: #ff6a00; border: 1px solid rgba(255,106,0,0.3); padding: 4px 10px; border-radius: 8px; font-size: 0.75rem;">
                                <i class="fa-solid fa-crown me-1"></i> Quản Lí
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background: rgba(59,130,246,0.12); color: #60a5fa; border: 1px solid rgba(59,130,246,0.2); padding: 4px 10px; border-radius: 8px; font-size: 0.75rem;">
                                <i class="fa-solid fa-user me-1"></i> User
                            </span>
                        }
                    </td>
                    <td class="py-3">
                        @if (u.IsActive)
                        {
                            <span class="badge" style="background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.25); padding: 4px 10px; border-radius: 8px; font-size: 0.75rem;">
                                <i class="fa-solid fa-circle me-1" style="font-size:0.5rem;vertical-align:middle;"></i> Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.25); padding: 4px 10px; border-radius: 8px; font-size: 0.75rem;">
                                <i class="fa-solid fa-lock me-1"></i> Đã khóa
                            </span>
                            @if (u.LockedAt is not null)
                            {
                                <div style="font-size:0.68rem;color:#94a3b8;margin-top:2px;">@u.LockedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        }
                    </td>
                    <td class="py-3" style="color: #94a3b8; white-space: nowrap;">
                        @u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        <div style="font-size:0.68rem;color:#64748b;">@u.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                    </td>
                    <td class="py-3 text-end px-3">
                        <div class="d-flex gap-1 justify-content-end">
                            @if (u.Role != "Admin")
                            {
                                if (u.IsActive)
                                {
                                    <form method="post" action="@Url.Action("UserLock", new { id = u.Id })" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm" title="Khóa tài khoản"
                                                style="background:rgba(239,68,68,0.1);color:#ef4444;border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:4px 10px;font-size:0.75rem;">
                                            <i class="fa-solid fa-lock"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("UserUnlock", new { id = u.Id })" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm" title="Mở khóa tài khoản"
                                                style="background:rgba(16,185,129,0.1);color:#34d399;border:1px solid rgba(16,185,129,0.2);border-radius:8px;padding:4px 10px;font-size:0.75rem;">
                                            <i class="fa-solid fa-unlock"></i>
                                        </button>
                                    </form>
                                }
                                <form method="post" action="@Url.Action("UserDelete", new { id = u.Id })" style="display:inline;" onsubmit="return confirm('Xác nhận xóa tài khoản @u.Email? Hành động này không thể hoàn tác.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm" title="Xóa tài khoản"
                                            style="background:rgba(239,68,68,0.08);color:#f87171;border:1px solid rgba(239,68,68,0.15);border-radius:8px;padding:4px 10px;font-size:0.75rem;">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span style="color:#64748b;font-size:0.72rem;font-style:italic;">—</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
