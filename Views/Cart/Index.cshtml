@model List<PhoneStore.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng";
    var total = ViewBag.Total ?? 0m;
}

<style>
    .cart-wrapper {
        background: rgba(13, 18, 30, 0.45);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 35px;
        margin-top: 20px;
        margin-bottom: 50px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    }
    .cart-item-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 18px 20px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        margin-bottom: 12px;
        transition: all 0.3s;
        position: relative;
    }
    .cart-item-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 106, 0, 0.25);
        transform: translateX(4px);
    }
    .cart-item-img-wrap {
        width: 80px;
        min-width: 80px;
        height: 80px;
        background: #ffffff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        flex-shrink: 0;
    }
    .cart-item-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .cart-item-body {
        flex: 1;
        min-width: 0;
    }
    .cart-item-body .item-name {
        color: #f1f5f9;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cart-item-body .item-name:hover {
        color: #ff6a00;
    }
    .cart-item-body .item-price-label {
        color: #94a3b8;
        font-size: 0.78rem;
        margin-top: 2px;
    }
    .cart-item-qty-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
    }
    .cart-item-qty-wrap .qty-input {
        width: 50px;
        background: rgba(7, 10, 18, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #ffffff;
        border-radius: 8px;
        padding: 5px 8px;
        text-align: center;
        font-weight: 700;
        font-size: 0.85rem;
    }
    .cart-item-qty-wrap .qty-input:focus {
        border-color: #ff6a00;
        outline: none;
    }
    .cart-item-qty-wrap .btn-qty {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        border-radius: 6px;
        width: 30px;
        height: 30px;
        font-size: 0.75rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .cart-item-qty-wrap .btn-qty:hover {
        background: rgba(255, 106, 0, 0.2);
        border-color: #ff6a00;
    }
    .cart-item-prices {
        text-align: right;
        flex-shrink: 0;
        margin-left: auto;
    }
    .cart-item-prices .item-unit-price {
        color: #94a3b8;
        font-size: 0.8rem;
        margin-bottom: 2px;
    }
    .cart-item-prices .item-subtotal {
        color: #ff0844;
        font-weight: 800;
        font-size: 1.1rem;
        white-space: nowrap;
    }
    .btn-item-remove {
        background: transparent;
        border: none;
        color: rgba(239, 68, 68, 0.4);
        font-size: 1rem;
        padding: 6px 10px;
        border-radius: 8px;
        transition: all 0.3s;
        cursor: pointer;
        flex-shrink: 0;
    }
    .btn-item-remove:hover {
        color: #ef4444;
        background: rgba(239, 68, 68, 0.1);
    }
    .cart-summary {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 28px;
        height: 100%;
    }
    .cart-summary h5 {
        color: #ff6a00;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 1.5px;
    }
    .total-amount {
        background: linear-gradient(135deg, #ff0844, #ff6a00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2rem;
        font-weight: 900;
    }
    .btn-checkout {
        background: linear-gradient(135deg, #ff6a00, #ee0979);
        color: #ffffff;
        border: none;
        padding: 16px 32px;
        border-radius: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
        font-size: 0.95rem;
    }
    .btn-checkout:hover {
        filter: brightness(1.1);
        box-shadow: 0 8px 30px rgba(238, 9, 121, 0.5);
        transform: translateY(-3px);
        color: #ffffff;
    }
    .btn-continue {
        background: transparent;
        color: #ff6a00;
        border: 2px solid #ff6a00;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-block;
    }
    .btn-continue:hover {
        background: rgba(255, 106, 0, 0.1);
        box-shadow: 0 0 20px rgba(255, 106, 0, 0.25);
        color: #ff6a00;
    }
    .cart-empty {
        text-align: center;
        padding: 70px 20px;
    }
    .cart-empty .empty-icon {
        font-size: 5rem;
        color: rgba(255, 255, 255, 0.06);
        margin-bottom: 24px;
        display: block;
    }
    .cart-empty h4 {
        color: #94a3b8;
        font-weight: 800;
        margin-bottom: 10px;
    }
    .cart-empty p {
        color: #64748b;
        margin-bottom: 28px;
    }
    .cart-count-badge {
        background: rgba(255, 106, 0, 0.12);
        color: #ff6a00;
        border-radius: 30px;
        padding: 4px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        display: inline-block;
    }
    .cart-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .cart-header-bar h3 {
        color: #ffffff;
        font-weight: 800;
        margin: 0;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .summary-row:last-of-type {
        border-bottom: none;
    }
    .summary-row .label {
        color: #94a3b8;
        font-size: 0.9rem;
    }
    .summary-row .value {
        color: #f1f5f9;
        font-weight: 700;
    }
    .summary-divider {
        border: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(255, 106, 0, 0.3), transparent);
        margin: 14px 0;
    }
</style>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted fw-bold">Trang Chủ</a></li>
            <li class="breadcrumb-item active text-white fw-bold" aria-current="page">Giỏ Hàng</li>
        </ol>
    </nav>

    <div class="cart-wrapper">
        @if (Model.Count == 0)
        {
            <div class="cart-empty">
                <i class="fa-solid fa-cart-shopping empty-icon"></i>
                <h4>Giỏ hàng trống</h4>
                <p>Khám phá ngay những sản phẩm công nghệ mới nhất!</p>
                <a href="/Product" class="btn-continue"><i class="fa-solid fa-store me-2"></i>Tiếp Tục Mua Sắm</a>
            </div>
        }
        else
        {
            <div class="cart-header-bar">
                <div>
                    <h3><i class="fa-solid fa-cart-shopping me-2" style="color: #ff6a00;"></i>Giỏ Hàng</h3>
                    <span class="cart-count-badge"><i class="fa-solid fa-cube me-1"></i>@Model.Count sản phẩm</span>
                </div>
                <span class="fw-bold" style="color: #94a3b8; font-size: 0.9rem;">
                    <i class="fa-regular fa-clock me-1"></i>Giao hàng hỏa tốc 2h
                </span>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item-card">
                            <div class="cart-item-img-wrap">
                                <img src="@item.ImageUrl" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1312/1312812.png'" alt="@item.ProductName" />
                            </div>
                            <div class="cart-item-body">
                                <a href="/Product/Details/@item.ProductId" class="item-name">@item.ProductName</a>
                                <div class="item-price-label">Đơn giá: @item.Price.ToString("N0")đ</div>
                                <div class="cart-item-qty-wrap">
                                    <form asp-action="UpdateQuantity" method="post" id="qtyForm-@item.ProductId" class="d-flex align-items-center gap-1">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="button" class="btn-qty" onclick="decrementQty(@item.ProductId)"><i class="fa-solid fa-minus"></i></button>
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="qty-input" id="qty-@item.ProductId" onchange="submitQty(@item.ProductId)" />
                                        <button type="button" class="btn-qty" onclick="incrementQty(@item.ProductId)"><i class="fa-solid fa-plus"></i></button>
                                    </form>
                                </div>
                            </div>
                            <div class="cart-item-prices">
                                <div class="item-unit-price">x @item.Quantity</div>
                                <div class="item-subtotal">@item.Subtotal.ToString("N0")đ</div>
                            </div>
                            <form asp-action="RemoveFromCart" method="post" onsubmit="return confirm('Xóa @item.ProductName khỏi giỏ hàng?')" class="flex-shrink-0">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn-item-remove" title="Xóa sản phẩm"><i class="fa-solid fa-xmark"></i></button>
                            </form>
                        </div>
                    }
                    <div class="mt-3">
                        <a href="/Product" class="btn-continue"><i class="fa-solid fa-arrow-left me-2"></i>Tiếp Tục Mua Sắm</a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart-summary">
                        <h5 class="mb-3"><i class="fa-regular fa-receipt me-2"></i>HOÁ ĐƠN</h5>
                        <div class="summary-row">
                            <span class="label">Tạm tính (@Model.Sum(c => c.Quantity) sản phẩm)</span>
                            <span class="value">@total.ToString("N0")đ</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Phí vận chuyển</span>
                            <span class="value" style="color: #22c55e;">—</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Giảm giá</span>
                            <span class="value" style="color: #22c55e;">0₫</span>
                        </div>
                        <hr class="summary-divider" />
                        <div class="summary-row">
                            <span class="label fw-bold" style="color: #f1f5f9; font-size: 1rem;">Tổng cộng</span>
                            <span class="total-amount">@total.ToString("N0")đ</span>
                        </div>
                        <p class="text-muted small mt-2 mb-3" style="font-size: 0.75rem;">
                            <i class="fa-regular fa-circle-check me-1" style="color: #22c55e;"></i>Phí vận chuyển sẽ được tính khi thanh toán
                        </p>
                        <a href="/Order/Checkout" class="btn-checkout w-100 d-block text-center text-decoration-none">
                            <i class="fa-solid fa-lock me-2"></i>Tiến Hành Đặt Hàng
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function decrementQty(id) {
        var input = document.getElementById('qty-' + id);
        var val = parseInt(input.value) || 1;
        if (val > 1) input.value = val - 1;
        submitQty(id);
    }
    function incrementQty(id) {
        var input = document.getElementById('qty-' + id);
        var val = parseInt(input.value) || 1;
        input.value = val + 1;
        submitQty(id);
    }
    function submitQty(id) {
        document.getElementById('qtyForm-' + id).submit();
    }
</script>
