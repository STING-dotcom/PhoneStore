@model List<PhoneStore.Models.CartItem>
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
    var total = ViewBag.Total ?? 0m;
    var walletBalance = ViewBag.WalletBalance as decimal? ?? 0m;
}

<style>
    .checkout-wrapper {
        background: rgba(13, 18, 30, 0.45);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 35px;
        margin-top: 20px;
        margin-bottom: 50px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    }
    .form-control-cyber {
        background: rgba(7, 10, 18, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #ffffff;
        border-radius: 10px;
        padding: 12px 16px;
        transition: all 0.3s;
    }
    .form-control-cyber:focus {
        border-color: #ff6a00;
        box-shadow: 0 0 10px rgba(255, 106, 0, 0.2);
        outline: none;
        color: #ffffff;
        background: rgba(7, 10, 18, 0.8);
    }
    .form-control-cyber::placeholder { color: rgba(255, 255, 255, 0.35); }
    .form-label-cyber {
        color: #94a3b8;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }
    .order-summary-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .order-summary-item:last-child { border-bottom: none; }
    .order-summary-img {
        width: 50px; height: 50px;
        object-fit: contain;
        background: #ffffff;
        border-radius: 8px;
        padding: 5px;
    }
    .payment-option {
        background: rgba(255, 255, 255, 0.02);
        border: 2px solid rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        padding: 14px 18px;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .payment-option:hover {
        border-color: rgba(255, 106, 0, 0.25);
        background: rgba(255, 106, 0, 0.04);
    }
    .payment-option.selected {
        border-color: #ff6a00;
        background: rgba(255, 106, 0, 0.08);
        box-shadow: 0 0 15px rgba(255, 106, 0, 0.1);
    }
    .payment-option .pay-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .payment-option .pay-name { color: #f1f5f9; font-weight: 700; font-size: 0.9rem; }
    .payment-option .pay-desc { color: #64748b; font-size: 0.78rem; }
    .payment-option .wallet-balance-small {
        font-size: 0.75rem;
        color: #64748b;
    }
    .payment-option .wallet-balance-small strong {
        color: #34d399;
    }
    .btn-place-order {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: #ffffff;
        border: none;
        padding: 16px 32px;
        border-radius: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 1.05rem;
        transition: all 0.3s;
        width: 100%;
    }
    .btn-place-order:hover {
        filter: brightness(1.1);
        box-shadow: 0 8px 30px rgba(56, 239, 125, 0.4);
        transform: translateY(-2px);
        color: #ffffff;
    }
    .order-total-label { color: #ff6a00; font-weight: 800; font-size: 1.2rem; }
    .order-total-amount {
        background: linear-gradient(135deg, #ff0844, #ff6a00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.8rem;
        font-weight: 900;
    }
</style>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted fw-bold">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a href="/Cart" class="text-decoration-none text-muted fw-bold">Giỏ Hàng</a></li>
            <li class="breadcrumb-item active text-white fw-bold" aria-current="page">Thanh Toán</li>
        </ol>
    </nav>

    <div class="checkout-wrapper">
        <h3 class="fw-bold text-white mb-4">
            <i class="fa-solid fa-file-invoice text-warning me-2"></i>Thông Tin Đặt Hàng
        </h3>

        <form asp-action="PlaceOrder" method="post" onsubmit="return validateForm()">
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-cyber"><i class="fa-solid fa-user me-1 text-warning"></i> Họ Tên *</label>
                            <input type="text" name="customerName" class="form-control form-control-cyber" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-cyber"><i class="fa-solid fa-phone me-1 text-warning"></i> Số Điện Thoại *</label>
                            <input type="tel" name="phone" class="form-control form-control-cyber" placeholder="0987654321" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-cyber"><i class="fa-solid fa-envelope me-1 text-warning"></i> Email *</label>
                            <input type="email" name="email" class="form-control form-control-cyber" placeholder="email@example.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-cyber"><i class="fa-solid fa-location-dot me-1 text-warning"></i> Địa Chỉ *</label>
                            <input type="text" name="address" class="form-control form-control-cyber" placeholder="Số nhà, đường, phường, quận, thành phố" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label-cyber"><i class="fa-solid fa-note-sticky me-1 text-warning"></i> Ghi Chú</label>
                            <textarea name="note" class="form-control form-control-cyber" rows="3" placeholder="Ghi chú thêm cho đơn hàng của bạn..."></textarea>
                        </div>

                        <div class="col-12 mt-4">
                            <h5 class="fw-bold text-white mb-3" style="font-size: 1rem;">
                                <i class="fa-solid fa-credit-card me-2" style="color: #f59e0b;"></i>Phương Thức Thanh Toán
                            </h5>
                            <input type="hidden" name="paymentMethod" id="selectedPayment" value="COD" />
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="payment-option selected" data-value="COD" onclick="selectPayment(this)">
                                        <div class="pay-icon" style="background: rgba(34, 197, 94, 0.12); color: #22c55e;"><i class="fa-solid fa-money-bill-wave"></i></div>
                                        <div>
                                            <div class="pay-name">Tiền mặt (COD)</div>
                                            <div class="pay-desc">Thanh toán khi nhận hàng</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option" data-value="Wallet" onclick="selectPayment(this)">
                                        <div class="pay-icon" style="background: rgba(255, 106, 0, 0.12); color: #ff6a00;"><i class="fa-solid fa-wallet"></i></div>
                                        <div>
                                            <div class="pay-name">Ví PhoneStore</div>
                                            <div class="pay-desc">Số dư: <strong style="color: #34d399;">@walletBalance.ToString("N0")đ</strong></div>
                                            @if (walletBalance < total)
                                            {
                                                <div class="wallet-balance-small"><i class="fa-regular fa-circle-exclamation me-1" style="color: #f59e0b;"></i>Không đủ: thiếu <strong style="color: #ef4444;">@((total - walletBalance).ToString("N0"))đ</strong></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option" data-value="BankTransfer" onclick="selectPayment(this)">
                                        <div class="pay-icon" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;"><i class="fa-solid fa-university"></i></div>
                                        <div>
                                            <div class="pay-name">Chuyển khoản ngân hàng</div>
                                            <div class="pay-desc">Vietcombank, Techcombank, MB Bank</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option" data-value="MoMo" onclick="selectPayment(this)">
                                        <div class="pay-icon" style="background: rgba(168, 85, 247, 0.12); color: #a855f7;"><i class="fa-brands fa-vuejs"></i></div>
                                        <div>
                                            <div class="pay-name">Ví MoMo</div>
                                            <div class="pay-desc">Quét mã QR thanh toán nhanh</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option" data-value="VNPAY" onclick="selectPayment(this)">
                                        <div class="pay-icon" style="background: rgba(16, 185, 129, 0.12); color: #10b981;"><i class="fa-solid fa-credit-card"></i></div>
                                        <div>
                                            <div class="pay-name">VNPAY</div>
                                            <div class="pay-desc">Thanh toán qua cổng VNPAY</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option" data-value="ScratchCard" onclick="selectPayment(this)">
                                        <div class="pay-icon" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;"><i class="fa-solid fa-sim-card"></i></div>
                                        <div>
                                            <div class="pay-name">Thẻ cào điện thoại</div>
                                            <div class="pay-desc">Viettel, Mobifone, Vinaphone</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="cart-summary" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 22px; position: sticky; top: 20px;">
                        <h5 class="fw-bold text-white mb-3"><i class="fa-solid fa-receipt text-warning me-2"></i>Đơn Hàng Của Bạn</h5>
                        <div class="mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var item in Model)
                            {
                                <div class="order-summary-item">
                                    <img src="@item.ImageUrl" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1312/1312812.png'" alt="@item.ProductName" class="order-summary-img" />
                                    <div class="flex-grow-1">
                                        <div class="text-white fw-semibold small">@item.ProductName</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">SL: @item.Quantity × @item.Price.ToString("N0")đ</div>
                                    </div>
                                    <div class="fw-bold text-white">@item.Subtotal.ToString("N0")đ</div>
                                </div>
                            }
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.1);" />
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Tạm tính:</span>
                            <span class="text-white fw-semibold">@total.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Phí vận chuyển:</span>
                            <span class="text-success fw-bold">Miễn phí</span>
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.1);" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="order-total-label">Tổng cộng:</span>
                            <span class="order-total-amount">@total.ToString("N0")đ</span>
                        </div>
                        <button type="submit" class="btn-place-order mt-4">
                            <i class="fa-solid fa-check-circle me-2"></i>Xác Nhận Đặt Hàng
                        </button>
                        <p class="text-muted small text-center mt-2 mb-0">
                            <i class="fa-solid fa-shield-halved me-1"></i>Thông tin của bạn được bảo mật tuyệt đối
                        </p>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function selectPayment(el) {
        document.querySelectorAll('.payment-option').forEach(c => c.classList.remove('selected'));
        el.classList.add('selected');
        document.getElementById('selectedPayment').value = el.dataset.value;
    }

    function validateForm() {
        var name = document.querySelector('[name="customerName"]');
        var phone = document.querySelector('[name="phone"]');
        var email = document.querySelector('[name="email"]');
        var address = document.querySelector('[name="address"]');

        if (!name.value.trim()) { alert('Vui lòng nhập họ tên.'); name.focus(); return false; }
        if (!phone.value.trim()) { alert('Vui lòng nhập số điện thoại.'); phone.focus(); return false; }
        if (!email.value.trim()) { alert('Vui lòng nhập email.'); email.focus(); return false; }
        if (!address.value.trim()) { alert('Vui lòng nhập địa chỉ.'); address.focus(); return false; }
        return true;
    }
</script>