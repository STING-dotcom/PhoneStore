@using PhoneStore.Models
@model User
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var txs = ViewBag.Transactions as List<WalletTransaction> ?? new();
}

<style>
    .acc-card {
        background: rgba(9,13,22,0.75);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
    }
    .acc-stat {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
        padding: 16px 20px;
        transition: all 0.3s;
    }
    .acc-stat:hover {
        border-color: rgba(255,106,0,0.3);
        background: rgba(255,106,0,0.04);
    }
    .acc-stat-icon {
        width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px;
        font-size: 1.1rem;
    }
    .info-label { color: #64748b; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .info-value { color: #f1f5f9; font-size: 0.95rem; font-weight: 600; }
    .tx-row {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        font-size: 0.85rem;
    }
    .tx-row:last-child { border-bottom: none; }
</style>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="acc-card p-4 text-center">
                <div style="width: 100px; height: 100px; margin: 0 auto 14px; border-radius: 50%; background: linear-gradient(135deg, #ff6a00, #ee0979); padding: 3px; position: relative;">
                    <img src="@(Model.AvatarUrl ?? "https://cdn-icons-png.flaticon.com/512/1144/1144760.png")"
                         class="rounded-circle" style="width:100%;height:100%;object-fit:cover;background:#090d16;" />
                </div>
                <h5 class="fw-bold text-white mb-1">@Model.FullName</h5>
                <p class="text-white-50" style="font-size:0.82rem;">@Model.Email</p>
                @if (Model.Role == "Admin")
                {
                    <span class="badge mb-2" style="background:rgba(255,106,0,0.15);color:#ff6a00;border:1px solid rgba(255,106,0,0.3);padding:4px 12px;border-radius:8px;font-size:0.75rem;"><i class="fa-solid fa-crown me-1"></i> Quản Lí</span>
                }
                <hr style="border-color:rgba(255,255,255,0.06);margin:16px 0;">
                <div class="d-flex flex-column gap-2">
                    <a asp-action="Edit" class="btn w-100 py-2 fw-bold rounded-3 text-start" style="background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);color:#60a5fa;font-size:0.85rem;">
                        <i class="fa-solid fa-pen me-2"></i> Chỉnh sửa thông tin
                    </a>
                    <a asp-action="ChangePassword" class="btn w-100 py-2 fw-bold rounded-3 text-start" style="background:rgba(255,106,0,0.08);border:1px solid rgba(255,106,0,0.2);color:#ff6a00;font-size:0.85rem;">
                        <i class="fa-solid fa-key me-2"></i> Đổi mật khẩu
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="acc-card p-4 mb-4" style="background:linear-gradient(135deg, rgba(255,106,0,0.06), rgba(238,9,121,0.04)); border-color: rgba(255,106,0,0.15);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="info-label mb-1"><i class="fa-solid fa-wallet me-1" style="color:#22c55e;"></i> Số dư ví</div>
                        <div class="fw-extrabold" style="font-size:1.6rem;background:linear-gradient(135deg,#22c55e,#10b981);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
                            @Model.WalletBalance.ToString("N0") <span style="font-size:0.9rem;">đ</span>
                        </div>
                    </div>
                    <a asp-controller="Wallet" asp-action="TopUp" class="btn py-2 px-4 fw-bold rounded-3" style="background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;font-size:0.85rem;">
                        <i class="fa-solid fa-plus me-1"></i> Nạp tiền
                    </a>
                </div>
            </div>

            <div class="acc-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-white m-0"><i class="fa-solid fa-clock-rotate-left me-2" style="color:#ff6a00;"></i> Giao dịch gần đây</h6>
                </div>

                @if (txs.Count == 0)
                {
                    <p class="text-white-50 text-center py-4 m-0" style="font-size:0.85rem;">Chưa có giao dịch nào.</p>
                }
                else
                {
                    <div>
                        @foreach (var tx in txs)
                        {
                            <div class="tx-row">
                                <div style="width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:@(tx.Amount >= 0 ? "rgba(16,185,129,0.12)" : "rgba(239,68,68,0.12)");color:@(tx.Amount >= 0 ? "#34d399" : "#ef4444");flex-shrink:0;">
                                    <i class="fa-solid @(tx.Amount >= 0 ? "fa-arrow-up" : "fa-arrow-down")" style="font-size:0.75rem;"></i>
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div class="fw-semibold text-white" style="font-size:0.82rem;">@tx.Type</div>
                                    <div class="text-white-50" style="font-size:0.72rem;">@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm") @(!string.IsNullOrEmpty(tx.Method) ? "· " + tx.Method : "")</div>
                                </div>
                                <div class="fw-bold text-end" style="color:@(tx.Amount >= 0 ? "#34d399" : "#ef4444");font-size:0.85rem;white-space:nowrap;">
                                    @(tx.Amount >= 0 ? "+" : "")@tx.Amount.ToString("N0")đ
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (txs.Count >= 20)
                {
                    <div class="text-center mt-3">
                        <a asp-controller="Wallet" asp-action="Index" class="text-decoration-none fw-semibold" style="color:#60a5fa;font-size:0.82rem;">Xem tất cả giao dịch <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
