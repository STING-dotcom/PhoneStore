@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    .cp-input {
        background: rgba(15,23,42,0.8) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        border-radius: 10px !important;
        color: #f1f5f9 !important;
        padding: 11px 14px !important;
    }
    .cp-input:focus {
        border-color: #ff6a00 !important;
        box-shadow: 0 0 0 3px rgba(255,106,0,0.15) !important;
    }
</style>

<div class="container py-5" style="max-width: 480px;">
    <div class="p-4" style="background:rgba(9,13,22,0.75);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.06);border-radius:16px;">
        <h5 class="fw-bold text-white mb-3"><i class="fa-solid fa-key me-2" style="color:#ff6a00;"></i> Đổi mật khẩu</h5>

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="alert border-0 d-flex align-items-center gap-2 py-2 px-3 mb-3" style="background:rgba(239,68,68,0.12);color:#ef4444;border-radius:10px;font-size:0.82rem;">
                    <i class="fa-solid fa-triangle-exclamation"></i> @err.ErrorMessage
                </div>
            }
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label text-white-50 fw-bold" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Mật khẩu hiện tại</label>
                <input type="password" name="currentPassword" required class="form-control cp-input" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" />
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 fw-bold" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Mật khẩu mới</label>
                <input type="password" name="newPassword" required class="form-control cp-input" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" />
                <div class="text-white-50 mt-1" style="font-size:0.7rem;">Ít nhất 6 ký tự.</div>
            </div>
            <div class="mb-4">
                <label class="form-label text-white-50 fw-bold" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Xác nhận mật khẩu mới</label>
                <input type="password" name="confirmPassword" required class="form-control cp-input" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" />
            </div>

            <button type="submit" class="btn w-100 py-2 fw-bold rounded-3" style="background:linear-gradient(135deg,#ff6a00,#ee0979);color:#fff;font-size:0.9rem;">
                <i class="fa-solid fa-check me-1-5"></i> Cập nhật mật khẩu
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none" style="color:#64748b;font-size:0.82rem;">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại tài khoản
            </a>
        </div>
    </div>
</div>
