@model User
@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<style>
    .avatar-upload-wrap {
        position: relative;
        width: 110px;
        height: 110px;
        margin: 0 auto;
        cursor: pointer;
    }
    .avatar-upload-wrap:hover .avatar-overlay { opacity: 1; }
    .avatar-upload-wrap:hover .avatar-preview-img { filter: brightness(0.7); }
    .avatar-overlay {
        position: absolute; inset: 3px; border-radius: 50%;
        background: rgba(0,0,0,0.55);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transition: opacity 0.3s;
        color: #fff; font-size: 0.75rem; font-weight: 700;
        flex-direction: column; gap: 4px;
        pointer-events: none;
    }
    .avatar-preview-img {
        width: 100%; height: 100%; object-fit: cover;
        border-radius: 50%; transition: all 0.3s;
    }
    .avatar-ring {
        width: 116px; height: 116px; margin: 0 auto 14px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff6a00, #ee0979);
        padding: 3px;
    }
    #avatarSpinner {
        display: none; width: 18px; height: 18px;
        border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff;
        border-radius: 50%; animation: authSpin 0.6s linear infinite;
        margin: 0 auto;
    }
    @@keyframes authSpin { to { transform: rotate(360deg); } }
</style>

<div class="container py-5" style="max-width: 560px;">
    <div class="p-4" style="background:rgba(9,13,22,0.75);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.06);border-radius:16px;">
        <h5 class="fw-bold text-white mb-4"><i class="fa-solid fa-pen me-2" style="color:#60a5fa;"></i> Chỉnh sửa thông tin</h5>

        <!-- Avatar Upload -->
        <div class="text-center mb-4">
            <div class="avatar-ring">
                <div class="avatar-upload-wrap" onclick="document.getElementById('avatarInput').click()">
                    <img id="avatarPreview"
                         src="@(Model.AvatarUrl ?? "https://cdn-icons-png.flaticon.com/512/1144/1144760.png")"
                         class="avatar-preview-img" />
                    <div class="avatar-overlay">
                        <i class="fa-solid fa-camera" style="font-size:1.2rem;"></i>
                        <span>Đổi ảnh</span>
                    </div>
                </div>
            </div>
            <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/gif,image/webp" style="display:none;" />
            <div id="avatarSpinner"></div>
            <div id="avatarStatus" style="font-size:0.78rem;margin-top:6px;"></div>
        </div>

        <form method="post" id="editForm">
            <div class="mb-3">
                <label class="form-label text-white-50 fw-bold" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Họ tên</label>
                <input type="text" name="fullName" value="@Model.FullName" required
                       class="form-control" style="background:rgba(15,23,42,0.8);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:#f1f5f9;padding:11px 14px;" />
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 fw-bold" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Số điện thoại</label>
                <input type="tel" name="phone" value="@Model.Phone"
                       class="form-control" style="background:rgba(15,23,42,0.8);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:#f1f5f9;padding:11px 14px;" />
            </div>
            <div class="mb-4">
                <label class="form-label text-white-50 fw-bold" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Email</label>
                <input type="email" value="@Model.Email" disabled
                       class="form-control" style="background:rgba(15,23,42,0.4);border:1px solid rgba(255,255,255,0.04);border-radius:10px;color:#64748b;padding:11px 14px;cursor:not-allowed;" />
                <div class="text-white-50 mt-1" style="font-size:0.7rem;">Email không thể thay đổi.</div>
            </div>

            <button type="submit" class="btn w-100 py-2 fw-bold rounded-3" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;font-size:0.9rem;">
                <i class="fa-solid fa-floppy-disk me-1-5"></i> Lưu thay đổi
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none" style="color:#64748b;font-size:0.82rem;">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại tài khoản
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var input = document.getElementById('avatarInput');
        var preview = document.getElementById('avatarPreview');
        var spinner = document.getElementById('avatarSpinner');
        var status = document.getElementById('avatarStatus');

        input.addEventListener('change', function () {
            var file = this.files[0];
            if (!file) return;

            // Preview local
            var reader = new FileReader();
            reader.onload = function (e) { preview.src = e.target.result; };
            reader.readAsDataURL(file);

            // Upload
            var formData = new FormData();
            formData.append('avatar', file);

            spinner.style.display = 'block';
            status.innerHTML = '<span style="color:#94a3b8;">Đang tải lên...</span>';

            fetch('/Account/UploadAvatar', {
                method: 'POST',
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                spinner.style.display = 'none';
                if (data.success) {
                    preview.src = data.url + '?t=' + Date.now();
                    status.innerHTML = '<span style="color:#34d399;"><i class="fa-solid fa-circle-check"></i> Cập nhật ảnh đại diện thành công</span>';
                    setTimeout(function () { status.innerHTML = ''; }, 3000);
                } else {
                    status.innerHTML = '<span style="color:#ef4444;"><i class="fa-solid fa-triangle-exclamation"></i> ' + data.message + '</span>';
                }
            })
            .catch(function () {
                spinner.style.display = 'none';
                status.innerHTML = '<span style="color:#ef4444;"><i class="fa-solid fa-triangle-exclamation"></i> Lỗi kết nối</span>';
            });
        });
    });
</script>
