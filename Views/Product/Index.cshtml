@model IEnumerable<PhoneStore.Models.Product>

@{
    ViewData["Title"] = "Hệ Thống Flagship Tối Thượng";
}

<style>
    :root {
        --cyber-orange: #ff6a00;
        --cyber-pink: #ee0979;
        --cyber-green: #10b981;
        --glass-bg: rgba(9, 13, 22, 0.65);
        --glass-border: rgba(255, 106, 0, 0.2);
    }

    /* Tiêu đề Bộ lọc */
    .filter-title {
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--cyber-orange);
        text-shadow: 0 0 10px rgba(255, 106, 0, 0.3);
    }

    /* Glassmorphism Sidebar Filter */
    .cyber-filter-card {
        background: var(--glass-bg) !important;
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border) !important;
        border-radius: 16px !important;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    /* Thiết kế item bộ lọc dạng danh sách */
    .custom-filter-group .list-group-item {
        border: 1px solid rgba(255, 255, 255, 0.03) !important;
        background-color: rgba(255, 255, 255, 0.02) !important;
        padding: 12px 16px;
        margin-bottom: 8px;
        border-radius: 10px !important;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.7) !important;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .custom-filter-group .list-group-item:hover {
        background: linear-gradient(135deg, rgba(255, 106, 0, 0.15), rgba(238, 9, 121, 0.05)) !important;
        border-color: var(--cyber-orange) !important;
        color: #ffffff !important;
        padding-left: 22px;
        box-shadow: 0 0 15px rgba(255, 106, 0, 0.2);
    }
    .custom-filter-group .list-group-item.active {
        background: linear-gradient(135deg, var(--cyber-orange), var(--cyber-pink)) !important;
        border: none !important;
        color: #ffffff !important;
        box-shadow: 0 0 15px rgba(238, 9, 121, 0.4);
    }

    /* 📱 CYBER CARD SẢN PHẨM - PHÂN TÁCH NỀN THÔNG MINH */
    .cyber-product-card {
        background: rgba(9, 13, 22, 0.85) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        border-radius: 18px !important;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
        position: relative;
    }
    .cyber-product-card:hover {
        transform: translateY(-8px);
        border-color: var(--cyber-pink) !important;
        box-shadow: 0 12px 30px rgba(238, 9, 121, 0.25);
    }
    
    /* 🔲 KHỐI NỀN TRẮNG HOÀN HẢO CHO ẢNH (Hòa tan viền ảnh gốc) */
    .cyber-img-container {
        position: relative;
        background: #ffffff !important; /* Đổi sang nền trắng tinh khiết để đồng màu ảnh */
        padding: 20px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px; /* Cố định chiều cao vùng ảnh để bố cục thẳng hàng */
        border-bottom: 2px solid rgba(255, 106, 0, 0.2); /* Đường cắt neon mảnh phân ranh giới */
    }
    .cyber-img-container img {
        transition: transform 0.5s ease;
        object-fit: contain;
        max-height: 100%;
        max-width: 100%;
        /* Khử bóng đen nguyên bản của CSS cũ để ảnh hòa chìm hoàn toàn vào nền trắng */
        filter: none !important; 
    }
    .cyber-product-card:hover .cyber-img-container img {
        transform: scale(1.08);
    }

    /* Thanh Search Neon */
    .cyber-search-input {
        background: rgba(9, 13, 22, 0.8) !important;
        border: 1px solid rgba(255, 106, 0, 0.4) !important;
        color: #ffffff !important;
        border-radius: 10px 0 0 10px !important;
        padding: 11px 18px;
    }
    .cyber-search-input:focus {
        box-shadow: 0 0 15px rgba(255, 106, 0, 0.3) !important;
        border-color: var(--cyber-orange) !important;
    }
    .cyber-search-btn {
        background: linear-gradient(135deg, var(--cyber-orange), var(--cyber-pink)) !important;
        border: none !important;
        color: white !important;
        font-weight: 700;
        border-radius: 0 10px 10px 0 !important;
        padding: 0 22px;
        transition: all 0.3s ease;
    }
    .cyber-search-btn:hover {
        box-shadow: 0 0 15px rgba(238, 9, 121, 0.5);
        opacity: 0.9;
    }

    /* Gợi ý Autocomplete Box */
    .cyber-suggest-box {
        background: #090d16 !important;
        border: 1px solid var(--cyber-orange) !important;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .cyber-suggest-box li {
        color: rgba(255,255,255,0.8) !important;
        transition: all 0.2s;
        border-bottom: 1px solid rgba(255,255,255,0.03);
    }
    .cyber-suggest-box li:hover {
        background: rgba(255, 106, 0, 0.12) !important;
        color: #ffffff !important;
    }

    /* Hệ thống phân trang Neon */
    .cyber-pagination .page-link {
        background: rgba(9, 13, 22, 0.8) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: rgba(255, 255, 255, 0.7) !important;
        padding: 10px 18px;
        margin: 0 3px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }
    .cyber-pagination .page-link:hover {
        border-color: var(--cyber-orange) !important;
        color: #ffffff !important;
        box-shadow: 0 0 10px rgba(255, 106, 0, 0.3);
    }
    .cyber-pagination .page-item.active .page-link {
        background: linear-gradient(135deg, var(--cyber-orange), var(--cyber-pink)) !important;
        border: none !important;
        color: white !important;
        box-shadow: 0 0 12px rgba(238, 9, 121, 0.4);
    }
    .cyber-pagination .page-item.disabled .page-link {
        opacity: 0.3;
        color: rgba(255, 255, 255, 0.3) !important;
    }

    /* Hiệu ứng Text */
    .hover-glow-text { transition: all 0.3s ease; }
    .hover-glow-text:hover { color: var(--cyber-orange) !important; text-shadow: 0 0 8px rgba(255,106,0,0.6); }
</style>

<div class="container py-4">
    <div class="text-center mb-5 position-relative">
        <h2 class="fw-extrabold text-uppercase text-transparent bg-clip-text" 
            style="background-image: linear-gradient(135deg, #ff6a00, #ee0979); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 2.3rem; letter-spacing: 2px; font-weight: 800;">
            <i class="fa-solid fa-layer-group me-3"></i>Kho Siêu Phẩm Flagship
        </h2>
        <p class="text-white-50 mt-2" style="font-size: 0.95rem;">Sở hữu ngay các cỗ máy di động tối tân nhất với mức giá tối ưu</p>
        <div style="width: 80px; height: 3px; background: linear-gradient(90deg, #ff6a00, #ee0979); margin: 15px auto 0; border-radius: 2px;"></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="cyber-filter-card p-4 sticky-top" style="top: 100px; z-index: 10;">
                
                <div class="mb-4">
                    <div class="filter-title mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-tags me-2"></i> Thương hiệu
                    </div>
                    <div class="list-group custom-filter-group">
                        <a href="@Url.Action("Index", "Product", new { brand = "", searchTerm = ViewBag.SearchTerm, priceRange = ViewBag.SelectedPriceRange })" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(string.IsNullOrEmpty(ViewBag.SelectedBrand) ? "active" : "")">
                            <span>Tất cả hãng</span>
                            <i class="fa-solid fa-circle-nodes opacity-50"></i>
                        </a>
                        @if (ViewBag.Brands != null)
                        {
                            foreach (var brand in ViewBag.Brands)
                            {
                                <a href="@Url.Action("Index", "Product", new { brand = brand, searchTerm = ViewBag.SearchTerm, priceRange = ViewBag.SelectedPriceRange })" 
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(ViewBag.SelectedBrand == brand ? "active" : "")">
                                    <span>@brand</span>
                                    <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem; opacity: 0.5;"></i>
                                </a>
                            }
                        }
                    </div>
                </div>

                <div>
                    <div class="filter-title mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-wallet me-2"></i> Khoảng giá
                    </div>
                    <div class="list-group custom-filter-group">
                        @{
                            var priceRanges = new Dictionary<string, string> {
                                { "", "Tất cả mức giá" },
                                { "under5", "Dưới 5 Triệu" },
                                { "5to10", "Từ 5 - 10 Triệu" },
                                { "10to20", "Từ 10 - 20 Triệu" },
                                { "over20", "Trên 20 Triệu" }
                            };
                        }
                        @foreach (var range in priceRanges)
                        {
                            <a href="@Url.Action("Index", "Product", new { brand = ViewBag.SelectedBrand, searchTerm = ViewBag.SearchTerm, priceRange = range.Key })" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(ViewBag.SelectedPriceRange == range.Key ? "active" : "")">
                                <span>@range.Value</span>
                                <i class="fa-solid fa-coins opacity-50"></i>
                            </a>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.SelectedBrand) || !string.IsNullOrEmpty(ViewBag.SearchTerm) || !string.IsNullOrEmpty(ViewBag.SelectedPriceRange))
                {
                    <a href="@Url.Action("Index", "Product")" class="btn btn-sm btn-outline-danger w-100 mt-4 py-2 fw-bold rounded-3">
                        <i class="fa-solid fa-trash-can me-2"></i>Xóa bộ lọc
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-9">
            
            <div class="mb-4 position-relative">
                <form method="get" action="@Url.Action("Index", "Product")" id="searchForm">
                    <input type="hidden" name="brand" value="@ViewBag.SelectedBrand" />
                    <input type="hidden" name="priceRange" value="@ViewBag.SelectedPriceRange" />
                    <div class="input-group shadow-sm">
                        <input type="text" id="searchInput" name="searchTerm" class="form-control cyber-search-input" 
                               placeholder="Nhập tên sản phẩm, công nghệ cần tìm kiếm..." autocomplete="off" value="@ViewBag.SearchTerm" />
                        <button class="btn cyber-search-btn" type="submit">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>TÌM KIẾM
                        </button>
                    </div>
                </form>
                <ul id="suggestionBox" class="list-unstyled position-absolute w-100 cyber-suggest-box mt-1 p-2" style="display: none; z-index: 999; max-height: 320px; overflow-y: auto;"></ul>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card h-100 cyber-product-card">
                                
                                <div class="cyber-img-container">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="d-flex align-items-center justify-content-center h-100 w-100">
                                        <img src="@product.ImageUrl" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1312/1312812.png'" alt="@product.Name" />
                                    </a>
                                </div>

                                <div class="card-body d-flex flex-column justify-content-between p-4">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-dark border border-secondary text-white-50 px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                                @product.Brand
                                            </span>
                                            <span class="text-white-50" style="font-size: 0.75rem;"><i class="fa-solid fa-microchip me-1"></i>Next-Gen</span>
                                        </div>
                                        <h6 class="card-title text-white fw-bold mb-2 text-truncate-2" style="font-size: 1.02rem; line-height: 1.4; height: 2.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-white hover-glow-text">
                                                @product.Name
                                            </a>
                                        </h6>
                                        <p class="text-white-50 mb-3" style="font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.4rem; line-height: 1.4;">
                                            @product.Description
                                        </p>
                                    </div>
                                    
                                    <div class="mt-2">
                                        <div class="text-transparent bg-clip-text fw-extrabold mb-3" 
                                             style="background-image: linear-gradient(135deg, #ff0844, #ffb199); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 1.25rem; font-weight: 800;">
                                            @product.Price.ToString("#,##0") <span style="font-size: 0.85rem;">VND</span>
                                        </div>
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" 
                                           class="btn btn-sm w-100 py-2 fw-bold text-white rounded-3 transition-all" 
                                           style="background: rgba(255, 106, 0, 0.08); border: 1px solid rgba(255, 106, 0, 0.4);">
                                            <i class="fa-solid fa-bolt me-2" style="color: var(--cyber-orange);"></i>Khám Phá Bản Thể
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <div class="cyber-filter-card p-5 d-inline-block">
                            <i class="fa-solid fa-radar mb-3" style="font-size: 3rem; color: var(--cyber-pink);"></i>
                            <h5 class="text-white fw-bold">Không tìm thấy thực thể phù hợp</h5>
                            <p class="text-white-50 m-0">Vui lòng tinh chỉnh bộ lọc hoặc từ khóa tìm kiếm của bạn.</p>
                        </div>
                    </div>
                }
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-5 d-flex justify-content-center">
                    <ul class="pagination cyber-pagination shadow-sm">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Product", new { page = ViewBag.CurrentPage - 1, brand = ViewBag.SelectedBrand, searchTerm = ViewBag.SearchTerm, priceRange = ViewBag.SelectedPriceRange })">
                                <i class="fa-solid fa-angle-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Product", new { page = i, brand = ViewBag.SelectedBrand, searchTerm = ViewBag.SearchTerm, priceRange = ViewBag.SelectedPriceRange })">@i</a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Product", new { page = ViewBag.CurrentPage + 1, brand = ViewBag.SelectedBrand, searchTerm = ViewBag.SearchTerm, priceRange = ViewBag.SelectedPriceRange })">
                                <i class="fa-solid fa-angle-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchInput");
        const suggestionBox = document.getElementById("suggestionBox");
        const selectedBrand = "@ViewBag.SelectedBrand";

        if (searchInput && suggestionBox) {
            searchInput.addEventListener("input", function () {
                const term = this.value.trim();
                if (term.length < 1) {
                    suggestionBox.style.display = "none";
                    return;
                }

                fetch(`/Product/GetSuggestions?term=${encodeURIComponent(term)}&brand=${encodeURIComponent(selectedBrand)}`)
                    .then(response => response.json())
                    .then(data => {
                        suggestionBox.innerHTML = "";
                        if (data && data.length > 0) {
                            data.forEach(product => {
                                const li = document.createElement("li");
                                li.className = "d-flex align-items-center gap-3 p-2.5 rounded-2 mb-1";
                                li.style.cursor = "pointer";

                                const img = document.createElement("img");
                                img.src = product.imageUrl || "https://cdn-icons-png.flaticon.com/512/1312/1312812.png";
                                img.className = "rounded-2 border border-secondary border-opacity-25";
                                img.style.width = "42px";
                                img.style.height = "42px";
                                img.style.objectFit = "contain";
                                img.style.background = "#ffffff";

                                const nameSpan = document.createElement("span");
                                nameSpan.className = "fw-semibold";
                                nameSpan.style.fontSize = "0.9rem";
                                nameSpan.innerText = product.name;

                                li.appendChild(img);
                                li.appendChild(nameSpan);
                                
                                li.addEventListener("click", function () {
                                    searchInput.value = product.name;
                                    suggestionBox.style.display = "none";
                                    searchInput.form.submit();
                                });
                                suggestionBox.appendChild(li);
                            });
                            suggestionBox.style.display = "block";
                        } else {
                            suggestionBox.style.display = "none";
                        }
                    });
            });

            document.addEventListener("click", function (e) {
                if (e.target !== searchInput && e.target !== suggestionBox) {
                    suggestionBox.style.display = "none";
                }
            });
        }
    });
</script>