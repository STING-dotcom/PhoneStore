@using System.Text.Json
@using System.Security.Claims
@using PhoneStore.Models
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _httpCtx
@inject PhoneStore.Data.AppDbContext _dbCtx
@{
    var cartJson = _httpCtx?.HttpContext?.Session?.GetString("CartItems");
    var cartItems = cartJson is not null ? JsonSerializer.Deserialize<List<CartItem>>(cartJson) ?? new() : new List<CartItem>();
    var cartCount = cartItems.Sum(c => c.Quantity);

    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var userName = isLoggedIn ? User.FindFirstValue(ClaimTypes.Name) : "";
    var userEmail = isLoggedIn ? User.FindFirstValue(ClaimTypes.Email) : "";
    var userRole = isLoggedIn ? User.FindFirstValue(ClaimTypes.Role) : "";
    var isAdmin = isLoggedIn && userRole == "Admin";

    string? userAvatarUrl = null;
    decimal walletBalance = 0;
    if (isLoggedIn)
    {
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdStr, out var uid))
        {
            var dbUser = _dbCtx.Users.Find(uid);
            if (dbUser is not null)
            {
                walletBalance = dbUser.WalletBalance;
                userAvatarUrl = dbUser.AvatarUrl;
            }
        }
    }
    else
    {
        var walletRaw = _httpCtx?.HttpContext?.Session?.GetString("WalletBalance");
        decimal.TryParse(walletRaw, out walletBalance);
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhoneStore</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhoneStore.styles.css" asp-append-version="true" />
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght=400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* 🎨 GLOBAL BRAND DESIGN SYSTEM - CYBERPUNK DARK MODE */
        :root {
            --primary-gradient: linear-gradient(135deg, #ff6a00, #ee0979);
            --secondary-gradient: linear-gradient(135deg, #ff6a00, #ffb100);
            --price-gradient: linear-gradient(135deg, #ff0844, #ffb199);
            --bg-dark: #070a12;
            --text-main: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.7);
        }

        /* ⚓ CẤU HÌNH STICKY FOOTER HOÀN HẢO */
        html {
            height: 100%;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            position: relative;
            
            /* Kích hoạt Flexbox trục dọc cho body */
            display: flex;
            flex-direction: column;
            min-height: 100%; /* Đảm bảo chiều cao tối thiểu bằng màn hình */
            margin: 0;
        }

        /* Thẻ main sẽ tự động co giãn để chiếm trọn không gian trống, đẩy footer xuống đáy */
        main {
            flex: 1 0 auto; 
        }

        /* Giữ cho footer không bị co bóp */
        footer {
            flex-shrink: 0;
        }

        #circuitCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-dark);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary-gradient);
            border-radius: 4px;
        }

        .cyber-dropdown-item {
            color: rgba(255, 255, 255, 0.85) !important;
            font-size: 0.95rem;
            transition: all 0.2s ease-in-out;
        }
        .cyber-dropdown-item:hover {
            color: #ffffff !important;
            background: linear-gradient(135deg, rgba(255, 106, 0, 0.15), rgba(238, 9, 121, 0.05)) !important;
            box-shadow: inset 0 0 8px rgba(255, 106, 0, 0.15);
        }

        .me-2-5 { margin-right: 0.65rem; }
        .chevron-rotate { transition: transform 0.3s ease; }

        /* 👤 AVATAR MORPHING AUTH BUTTON */
        .cyber-auth-wrapper { position: relative; }
        .cyber-avatar-morph-btn {
            text-decoration: none !important;
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(255, 106, 0, 0.05);
            border: 1px solid rgba(255, 106, 0, 0.3);
            border-radius: 30px;
            padding: 4px;
            transition: all 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
            cursor: pointer;
            max-width: 44px;
            height: 44px;
        }
        .cyber-avatar-morph-btn:hover {
            max-width: 170px; 
            background: linear-gradient(135deg, rgba(255, 106, 0, 0.15), rgba(238, 9, 121, 0.2));
            border-color: #ee0979;
            box-shadow: 0 0 15px rgba(238, 9, 121, 0.4);
            padding-right: 18px;
        }
        .avatar-frame {
            position: relative;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid #ff6a00;
            overflow: hidden;
            background: #090d16;
            flex-shrink: 0;
            transition: all 0.45s ease;
        }
        .cyber-avatar-morph-btn:hover .avatar-frame {
            border-color: #ee0979;
            transform: rotate(360deg);
        }
        .avatar-img { width: 100%; height: 100%; object-fit: cover; }
        .login-text {
            color: #ffffff;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            white-space: nowrap;
            margin-left: 10px;
            opacity: 0;
            transform: translateX(-15px);
            transition: all 0.35s ease;
        }
        .cyber-avatar-morph-btn:hover .login-text { opacity: 1; transform: translateX(0); }
        .scanner-line {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 2px;
            background: #ee0979; box-shadow: 0 0 8px #ee0979;
            animation: cyberScan 2s linear infinite;
        }
        @@keyframes cyberScan {
            0% { top: 0%; }
            50% { top: 100%; }
            100% { top: 0%; }
        }

        /* 👑 STYLE HOVER CHO LINK FOOTER XỊN XÒ */
        .hover-glow-text { transition: all 0.3s ease; }
        .hover-glow-text:hover { color: #ff6a00 !important; text-shadow: 0 0 8px rgba(255,106,0,0.6); padding-left: 4px; }
        
        .cyber-social-icon {
            transition: all 0.3s ease;
        }
        .cyber-social-icon:hover {
            transform: translateY(-3px);
            color: #ffffff !important;
            border-color: #ee0979 !important;
            box-shadow: 0 0 12px rgba(238, 9, 121, 0.5);
        }
        @@keyframes pulse-slow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        .animate-pulse { animation: pulse-slow 2s infinite; }

        /* 🌍 GLOBAL TEXT COLOR FIX: Đánh mạnh tay chữ đen trên nền tối */
        body, p, span, div, h1, h2, h3, h4, h5, h6, li, td, th, input, textarea, select, option, label, small, strong, b, em, i, a:not(.dropdown-item):not(.nav-link):not(.list-group-item) {
            color: #f1f5f9;
        }
        .breadcrumb-item.active, .breadcrumb-item a, .text-muted, .text-white-50, .text-secondary, small, .text-body-secondary {
            color: #94a3b8 !important;
        }
        .breadcrumb-item.active { color: #ffffff !important; }
        a { color: #ffffff; }
        a:hover { color: #ff6a00; }
        .table { color: #f1f5f9 !important; }
        .table td, .table th { color: inherit; }
        .dropdown-item { color: rgba(255,255,255,0.85) !important; }
        .dropdown-item:hover { color: #ffffff !important; }
        input, textarea, select { color: #ffffff !important; }
        input::placeholder, textarea::placeholder { color: rgba(255,255,255,0.35) !important; }
    </style>
</head>
<body>
    <canvas id="circuitCanvas"></canvas>

    <header style="position: relative; z-index: 9999;">
        <nav class="navbar navbar-dark shadow-sm py-3" style="background: #070a12; border-bottom: 2px solid rgba(255, 106, 0, 0.45);">
            <div class="container d-flex justify-content-between align-items-center">
                
                <div class="d-flex align-items-center gap-3">
                    <a class="navbar-brand fw-bold text-transparent bg-clip-text m-0" style="background-image: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 1.5rem; letter-spacing: 0.5px;" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-microchip me-2" style="color: #ff6a00; -webkit-text-fill-color: initial;"></i>PhoneStore
                    </a>

                    <div class="dropdown">
                        <button class="btn d-flex align-items-center justify-content-center p-0 rounded-3 border-0 shadow-none" 
                                type="button" 
                                id="headerCyberMenu" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false" 
                                style="background: rgba(255, 106, 0, 0.08); border: 1px solid rgba(255, 106, 0, 0.35) !important; color: #ffffff; width: 38px; height: 38px;">
                            <i class="fa-solid fa-chevron-down text-white chevron-rotate" style="font-size: 0.85rem;"></i>
                        </button>
                        
                        <ul class="dropdown-menu p-2 border-0 shadow-lg" 
                            aria-labelledby="headerCyberMenu" 
                            style="background: #090d16; border: 1px solid rgba(255, 106, 0, 0.25) !important; min-width: 190px; border-radius: 12px;">
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fa-solid fa-house me-2-5" style="color: #ff6a00; width: 18px;"></i>Trang chủ
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Product" asp-action="Index">
                                    <i class="fa-solid fa-mobile-screen-button me-2-5" style="color: #ffb100; width: 18px;"></i>Sản phẩm
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Security">
                                    <i class="fa-solid fa-shield-halved me-2-5" style="color: #10b981; width: 18px;"></i>Bảo mật
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Wallet" asp-action="Index">
                                    <i class="fa-solid fa-wallet me-2-5" style="color: #22c55e; width: 18px;"></i>Ví của tôi
                                    <span class="ms-auto badge rounded-pill fw-bold" style="background: rgba(16,185,129,0.15); color: #34d399; font-size: 0.65rem; border: 1px solid rgba(16,185,129,0.3); padding: 2px 8px;">
                                        @walletBalance.ToString("N0")đ
                                    </span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.08);"></li>
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center position-relative" asp-area="" asp-controller="Cart" asp-action="Index">
                                    <i class="fa-solid fa-cart-shopping me-2-5" style="color: #ffb100; width: 18px;"></i>Giỏ hàng
                                    @if (cartCount > 0)
                                    {
                                        <span class="position-absolute top-0 end-0 translate-middle badge rounded-pill" style="background: #ef4444; font-size: 0.6rem; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; padding: 0 4px; box-shadow: 0 0 6px rgba(239,68,68,0.6);">
                                            @cartCount
                                        </span>
                                    }
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="cyber-auth-wrapper d-flex align-items-center gap-3">
                    <a href="/Wallet" class="text-decoration-none d-flex align-items-center gap-2 px-3 py-1 rounded-3" style="background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.2); transition: all 0.3s;" onmouseover="this.style.borderColor='#34d399'" onmouseout="this.style.borderColor='rgba(16,185,129,0.2)'">
                        <i class="fa-solid fa-wallet" style="color: #34d399; font-size: 0.85rem;"></i>
                        <span style="color: #34d399; font-weight: 700; font-size: 0.85rem;">@walletBalance.ToString("N0")<span style="font-size: 0.65rem;">đ</span></span>
                    </a>

                    @if (isLoggedIn)
                    {
                        <div class="dropdown" style="position: relative;">
                            <a class="cyber-avatar-morph-btn" href="javascript:void(0)" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="max-width: 170px; background: linear-gradient(135deg, rgba(255,106,0,0.15), rgba(238,9,121,0.2)); border-color: #ee0979; padding-right: 18px; cursor: default;">
                                <div class="avatar-frame">
                                    <img src="@(userAvatarUrl ?? "~/images/avatar-default.png")" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1144/1144760.png'" alt="User Avatar" class="avatar-img" />
                                    <div class="scanner-line"></div>
                                </div>
                                <span class="login-text" style="opacity: 1; transform: translateX(0);">@userName</span>
                            </a>
                            <ul class="dropdown-menu p-2 border-0 shadow-lg" style="background: #090d16; border: 1px solid rgba(255,106,0,0.25) !important; min-width: 200px; border-radius: 12px;">
                                <li><span class="dropdown-item-text py-1 px-3 text-white-50" style="font-size: 0.75rem;">@userEmail</span></li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.08);"></li>
                                @if (isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="fa-solid fa-shield-halved me-2-5" style="color: #ff6a00; width: 18px;"></i>Quản Lí
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Account" asp-action="Index">
                                        <i class="fa-solid fa-user me-2-5" style="color: #60a5fa; width: 18px;"></i>Tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Wallet" asp-action="Index">
                                        <i class="fa-solid fa-wallet me-2-5" style="color: #22c55e; width: 18px;"></i>Ví của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Cart" asp-action="Index">
                                        <i class="fa-solid fa-cart-shopping me-2-5" style="color: #ffb100; width: 18px;"></i>Giỏ hàng
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.08);"></li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 rounded-3 fw-semibold cyber-dropdown-item d-flex align-items-center" asp-area="" asp-controller="Auth" asp-action="Logout">
                                        <i class="fa-solid fa-right-from-bracket me-2-5" style="color: #ef4444; width: 18px;"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="cyber-avatar-morph-btn" href="javascript:void(0)" onclick="openLoginModal()">
                            <div class="avatar-frame">
                                <img src="~/images/avatar-default.png" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1144/1144760.png'" alt="User Avatar" class="avatar-img" />
                                <div class="scanner-line"></div>
                            </div>
                            <span class="login-text">ĐĂNG NHẬP</span>
                        </a>
                    }
                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        <div class="container mt-4">
            @RenderBody()
        </div>
    </main>

    <footer class="py-5" style="background: rgba(4, 6, 11, 0.95); border-top: 2px solid #ee0979; box-shadow: 0 -5px 25px rgba(238, 9, 121, 0.2); backdrop-filter: blur(15px);">
        <div class="container">
            <div class="row gy-4 text-start">
                
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 text-transparent bg-clip-text" style="background-image: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 1.35rem; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-microchip me-2"></i>PHONESTORE SYSTEM
                    </h5>
                    <p class="text-white mb-3" style="font-size: 0.92rem; line-height: 1.6; opacity: 0.95;">
                        Trải nghiệm không gian mua sắm di động tương lai. Nơi tích hợp công nghệ mã hóa tối tân cùng các dòng Flagship tối thượng nhất hành tinh.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-dark border border-success text-success px-2.5 py-1.5" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;">
                            <i class="fa-solid fa-circle-check me-1 animate-pulse"></i> CORE SYSTEM: ONLINE
                        </span>
                        <span class="badge bg-dark border border-info text-info px-2.5 py-1.5" style="font-size: 0.75rem; font-weight: 700;">
                            v3.1.0-NEXT
                        </span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 ms-auto">
                    <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 1px; font-size: 0.85rem; color: #ff6a00 !important;">Ban Điều Hành & Dự Án</h6>
                    <ul class="list-unstyled d-flex flex-column gap-3" style="font-size: 0.9rem; color: #ffffff;">
                        <li>
                            <i class="fa-solid fa-user-tie me-2 text-danger"></i>
                            <span class="text-white-50">CEO:</span> <strong style="text-shadow: 0 0 5px rgba(255,255,255,0.2);">Hoàng Việt Anh</strong>
                        </li>
                        <li class="pt-1 border-top border-secondary border-opacity-25">
                            <i class="fa-solid fa-code me-2 text-info"></i>
                            <span class="text-white-50">Phát triển:</span> <span class="fw-semibold">Nguyễn Trung Kiên</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-code me-2 text-info"></i>
                            <span class="text-white-50">Phát triển:</span> <span class="fw-semibold">Trần Đức Anh</span>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 1px; font-size: 0.85rem; color: #ff6a00 !important;">Hệ Thống</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2" style="font-size: 0.9rem;">
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-white-50 hover-glow-text"><i class="fa-solid fa-angle-right me-1.5 text-danger"></i> Trang Chủ</a></li>
                        <li><a asp-controller="Product" asp-action="Index" class="text-decoration-none text-white-50 hover-glow-text"><i class="fa-solid fa-angle-right me-1.5 text-danger"></i> Sản Phẩm</a></li>
                        <li><a asp-controller="Home" asp-action="Security" class="text-decoration-none text-white-50 hover-glow-text"><i class="fa-solid fa-angle-right me-1.5 text-success"></i> Bảo Mật</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 1px; font-size: 0.85rem; color: #ff6a00 !important;">Kênh Truyền Thông</h6>
                    <div class="d-flex gap-3 mb-4">
                        <a href="https://www.facebook.com/Vanhsociuuu" target="_blank" rel="noopener noreferrer" class="cyber-social-icon text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(255,106,0,0.1); border: 1px solid rgba(255,106,0,0.3); border-radius: 8px;" title="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="https://github.com/STING-dotcom/PhoneStore/tree/main" target="_blank" rel="noopener noreferrer" class="cyber-social-icon text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;" title="GitHub">
                            <i class="fa-brands fa-github"></i>
                        </a>
                        <a href="https://www.tiktok.com/@@hong_tham228?is_from_webapp=1&sender_device=pc" target="_blank" rel="noopener noreferrer" class="cyber-social-icon text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(238,9,121,0.1); border: 1px solid rgba(238,9,121,0.3); border-radius: 8px;" title="TikTok">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>
                    </div>
                    <p class="text-white-50 m-0" style="font-size: 0.8rem;">&copy; 2026 PhoneStore. Bản quyền thuộc Nhóm 6.</p>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <style>
        /* ===== AUTH MODAL (LOGIN / REGISTER) ===== */
        .auth-overlay {
            position: fixed; inset: 0; z-index: 9999;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(6px);
            display: none;
            align-items: center;
            justify-content: center;
            animation: authFadeIn 0.25s ease;
        }
        .auth-overlay.active { display: flex; }
        @@keyframes authFadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        .auth-modal {
