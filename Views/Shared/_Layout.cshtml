        @@keyframes magicTiltIn { 0%{opacity:0;transform:perspective(600px) rotateX(12deg) translateY(30px)} 100%{opacity:1;transform:perspective(600px) rotateX(0) translateY(0)} }

        .magic-slide-up { opacity:0; animation: magicSlideUp 0.65s cubic-bezier(0.22,1,0.36,1) forwards; }
        .magic-zoom-bounce { opacity:0; animation: magicZoomBounce 0.6s cubic-bezier(0.34,1.56,0.64,1) forwards; }
