        function normalize(s) {
            var r = s.toLowerCase();
            r = r.replace(/à|á|ạ|ã|ả|ă|ắ|ằ|ẵ|ặ|ẳ|â|ấ|ầ|ẫ|ậ|ẩ/g,'a');
            r = r.replace(/è|é|ẹ|ẽ|ẻ|ê|ế|ề|ễ|ệ|ể/g,'e');
            r = r.replace(/ì|í|ị|ĩ|ỉ/g,'i');
            r = r.replace(/ò|ó|ọ|õ|ỏ|ô|ố|ồ|ỗ|ộ|ổ|ơ|ớ|ờ|ỡ|ợ|ở/g,'o');
            r = r.replace(/ù|ú|ụ|ũ|ủ|ư|ứ|ừ|ữ|ự|ử/g,'u');
            r = r.replace(/ỳ|ý|ỵ|ỹ|ỷ/g,'y');
            r = r.replace(/đ/g,'d');
            r = r.replace(/[^a-z0-9\s]/g,' ');
            return r.trim().replace(/\s+/g,' ');
        }

        function findAnswer(input) {
            var norm = normalize(input);
            if (!norm) return null;
            var words = norm.split(/\s+/);

            var best = null, bestScore = 0;
            for (var i = 0; i < kb.length; i++) {
                var kwNorm = kb[i]._norm;
                if (!kwNorm) {
                    kb[i]._norm = kb[i].kw.map(function(k){ return normalize(k); });
                    kwNorm = kb[i]._norm;
                }
                var score = 0;
                for (var j = 0; j < words.length; j++) {
                    for (var k = 0; k < kwNorm.length; k++) {
                        if (kwNorm[k].indexOf(words[j]) !== -1 || words[j].indexOf(kwNorm[k]) !== -1) {
                            score += 2;
                        }
                    }
                }
                for (var k = 0; k < kwNorm.length; k++) {
                    if (norm.indexOf(kwNorm[k]) !== -1) { score += 3; }
                }
                if (score > bestScore) { bestScore = score; best = kb[i]; }
            }
            return bestScore >= 3 ? best.ans : null;
        }

        function sendMessage() {
            if (!chatOpen) { openChat(); return; }
            var input = document.getElementById('chatInput');
            var text = input.value.trim();
            if (!text) return;
            input.value = '';
            addUserMsg(text);
            document.getElementById('chatSendBtn').disabled = true;
            showTyping();
            setTimeout(function() {
                hideTyping();
                document.getElementById('chatSendBtn').disabled = false;
                var ans = findAnswer(text);
                if (ans) {
                    addBotMsg(ans);
                } else {
                    addBotMsg('🤔 Mình chưa có sẵn câu trả lời cho "' + text.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '". Bạn thử chọn <b>gợi ý</b> bên dưới hoặc diễn đạt lại câu hỏi nhé!');
                }
                renderSuggestions();
            }, 600 + Math.random() * 400);
        }

        function handleSuggestion(text) {
            addUserMsg(text);
            var idx = usedSuggestions.indexOf(text);
            if (idx === -1) usedSuggestions.push(text);
            showTyping();
            setTimeout(function() {
                hideTyping();
                var ans = findAnswer(text);
                if (ans) addBotMsg(ans);
                renderSuggestions();
            }, 400 + Math.random() * 300);
        }

        function renderSuggestions() {
            var el = document.getElementById('chatSuggestions');
            var avail = initialSuggestions.filter(function(s) { return usedSuggestions.indexOf(s) === -1; });
            if (avail.length === 0) {
                el.innerHTML = '<div style="font-size:0.7rem;color:#64748b;width:100%;text-align:center;padding:4px 0;">— Bạn có thể gõ câu hỏi bất kì —</div>';
                return;
            }
            var html = '';
            for (var i = 0; i < Math.min(avail.length, 4); i++) {
                html += '<span class="chip" onclick="handleSuggestion(\'' + avail[i].replace(/'/g,"\\'") + '\')">' + avail[i] + '</span>';
            }
            el.innerHTML = html;
        }
    </script>
    <!-- ===== AUTH MODAL ===== -->
    <div class="auth-overlay" id="authOverlay" onclick="if(event.target===this)closeAuthModal()">
        <div class="auth-modal">
            <button class="auth-close" onclick="closeAuthModal()">&times;</button>

            <div class="auth-title" style="text-align:center;font-size:1.2rem;">&#x1f512; BẢO MẬT</div>
            <div class="auth-subtitle" style="text-align:center;">Đăng nhập để trải nghiệm đầy đủ tính năng</div>

            <!-- Tabs -->
            <div class="auth-tabs" role="tablist">
                <button class="auth-tab active" data-tab="login" onclick="switchAuthTab('login')"><i class="fa-solid fa-arrow-right-to-bracket"></i> Đăng nhập</button>
                <button class="auth-tab" data-tab="register" onclick="switchAuthTab('register')"><i class="fa-solid fa-user-plus"></i> Đăng kí</button>
            </div>

            <!-- LOGIN PANEL -->
            <div class="auth-panel active" id="panelLogin">
                <div class="auth-form">
                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input type="email" class="form-input" id="loginEmail" placeholder="your@email.com" autocomplete="email" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Mật khẩu</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input type="password" class="form-input" id="loginPassword" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" autocomplete="current-password" />
                            <button type="button" class="pw-toggle" onclick="togglePw('loginPassword',this)" tabindex="-1" aria-label="Toggle password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>

                    <button class="auth-btn" id="loginBtn" onclick="handleLogin()">
                        <span class="spinner"></span>
                        <span class="btn-text"><i class="fa-solid fa-arrow-right-to-bracket me-1-5"></i> Đăng nhập</span>
                    </button>

                    <div class="auth-footer-text" id="loginError" style="color:#ef4444;font-size:0.78rem;display:none;"></div>
                    <p class="auth-panel-note">Bằng cách đăng nhập, bạn đồng ý với <span style="color:#60a5fa;cursor:default;">Điều khoản</span> của chúng tôi.</p>
                </div>
            </div>

            <!-- REGISTER PANEL -->
            <div class="auth-panel" id="panelRegister">
                <div class="auth-form">
                    <div class="form-group">
                        <label>Họ tên</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-user input-icon"></i>
                            <input type="text" class="form-input" id="regName" placeholder="Nguyễn Văn A" autocomplete="name" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input type="email" class="form-input" id="regEmail" placeholder="your@email.com" autocomplete="email" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-phone input-icon"></i>
                            <input type="tel" class="form-input" id="regPhone" placeholder="0123 456 789" autocomplete="tel" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Mật khẩu</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input type="password" class="form-input" id="regPassword" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" autocomplete="new-password" />
                            <button type="button" class="pw-toggle" onclick="togglePw('regPassword',this)" tabindex="-1" aria-label="Toggle password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Xác nhận mật khẩu</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-shield-halved input-icon"></i>
                            <input type="password" class="form-input" id="regConfirm" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" autocomplete="new-password" />
                            <button type="button" class="pw-toggle" onclick="togglePw('regConfirm',this)" tabindex="-1" aria-label="Toggle password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>

                    <button class="auth-btn" id="regBtn" onclick="handleRegister()">
                        <span class="spinner"></span>
                        <span class="btn-text"><i class="fa-solid fa-user-plus me-1-5"></i> Đăng kí</span>
                    </button>

                    <div class="auth-footer-text" id="regError" style="color:#ef4444;font-size:0.78rem;display:none;"></div>
                    <p class="auth-panel-note">Bằng cách đăng kí, bạn đồng ý với <span style="color:#60a5fa;cursor:default;">Điều khoản</span> và <span style="color:#60a5fa;cursor:default;">Chính sách bảo mật</span>.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        /* ===== AUTH: TAB SWITCHING ===== */
        function switchAuthTab(tab) {
            var tabs = document.querySelectorAll('.auth-tab');
            tabs.forEach(function(t) { t.classList.remove('active'); });
            document.querySelector('.auth-tab[data-tab="' + tab + '"]').classList.add('active');
            var panels = document.querySelectorAll('.auth-panel');
            panels.forEach(function(p) { p.classList.remove('active'); });
            document.getElementById('panel' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
            document.getElementById('loginError').style.display = 'none';
            document.getElementById('regError').style.display = 'none';
        }

        /* ===== AUTH: PASSWORD TOGGLE ===== */
        function togglePw(inputId, btn) {
            var inp = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'fa-regular fa-eye-slash';
            } else {
                inp.type = 'password';
                icon.className = 'fa-regular fa-eye';
            }
        }

        /* ===== AUTH: MODAL OPEN/CLOSE ===== */
        function openLoginModal() {
            document.getElementById('authOverlay').classList.add('active');
            switchAuthTab('login');
            document.body.style.overflow = 'hidden';
        }
        function closeAuthModal() {
            document.getElementById('authOverlay').classList.remove('active');
            document.body.style.overflow = '';
            document.getElementById('loginBtn').classList.remove('loading');
            document.getElementById('regBtn').classList.remove('loading');
        }

        /* ===== AUTH: LOGIN ===== */
        function handleLogin() {
            var email = document.getElementById('loginEmail').value.trim();
            var password = document.getElementById('loginPassword').value.trim();
            var errEl = document.getElementById('loginError');
            var btn = document.getElementById('loginBtn');

            if (!email || !password) {
                errEl.textContent = 'Vui lòng nhập email và mật khẩu';
                errEl.style.display = 'block';
                errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
                return;
            }

            btn.classList.add('loading');
            errEl.style.display = 'none';

            fetch('/Auth/Login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'email=' + encodeURIComponent(email) + '&password=' + encodeURIComponent(password)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                btn.classList.remove('loading');
                if (data.success) {
                    closeAuthModal();
                    location.reload();
                } else {
                    errEl.textContent = data.message;
                    errEl.style.display = 'block';
                    errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
                }
            })
            .catch(function() {
                btn.classList.remove('loading');
                errEl.textContent = 'Lỗi kết nối, vui lòng thử lại';
                errEl.style.display = 'block';
                errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
            });
        }

        /* ===== AUTH: REGISTER ===== */
        function handleRegister() {
            var fullName = document.getElementById('regName').value.trim();
            var email = document.getElementById('regEmail').value.trim();
            var phone = document.getElementById('regPhone').value.trim();
            var password = document.getElementById('regPassword').value.trim();
            var confirmPassword = document.getElementById('regConfirm').value.trim();
            var errEl = document.getElementById('regError');
            var btn = document.getElementById('regBtn');

            if (!fullName || !email || !password || !confirmPassword) {
                errEl.textContent = 'Vui lòng nhập đầy đủ thông tin';
                errEl.style.display = 'block';
                errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
                return;
            }
            if (password !== confirmPassword) {
                errEl.textContent = 'Mật khẩu xác nhận không khớp';
                errEl.style.display = 'block';
                errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
                return;
            }
            if (password.length < 6) {
                errEl.textContent = 'Mật khẩu phải có ít nhất 6 kí tự';
                errEl.style.display = 'block';
                errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
                return;
            }

            btn.classList.add('loading');
            errEl.style.display = 'none';

            fetch('/Auth/Register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'fullName=' + encodeURIComponent(fullName) + '&email=' + encodeURIComponent(email) + '&phone=' + encodeURIComponent(phone) + '&password=' + encodeURIComponent(password) + '&confirmPassword=' + encodeURIComponent(confirmPassword)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                btn.classList.remove('loading');
                if (data.success) {
                    switchAuthTab('login');
                    document.getElementById('loginEmail').value = email;
                    document.getElementById('loginPassword').value = '';
                    errEl.textContent = '';
                    errEl.style.display = 'none';
                } else {
                    errEl.textContent = data.message;
                    errEl.style.display = 'block';
                    errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
                }
            })
            .catch(function() {
                btn.classList.remove('loading');
                errEl.textContent = 'Lỗi kết nối, vui lòng thử lại';
                errEl.style.display = 'block';
                errEl.classList.remove('auth-error-shake'); void errEl.offsetWidth; errEl.classList.add('auth-error-shake');
            });
        }

        /* ===== TOAST ===== */
        function showToast(message, type) {
            if (!message) return;
            var container = document.getElementById('toastContainer');
            var icon = type === 'success' ? 'fa-solid fa-circle-check' : 'fa-solid fa-triangle-exclamation';
            var toast = document.createElement('div');
            toast.className = 'toast-item toast-' + (type || 'success');
            toast.innerHTML = '<i class="' + icon + '"></i><span>' + message + '</span><button class="toast-close" onclick="this.parentElement.remove()">&times;</button>';
            container.appendChild(toast);
            requestAnimationFrame(function() { toast.classList.add('show'); });
            setTimeout(function() {
                toast.classList.remove('show');
                toast.classList.add('hide');
                setTimeout(function() { toast.remove(); }, 400);
            }, 3500);
        }

        @{
            var toasts = new List<string>();
            if (TempData["Success"] is not null) { toasts.Add($"showToast({Json.Serialize(TempData["Success"])},'success')"); }
            if (TempData["ReviewSuccess"] is not null) { toasts.Add($"showToast({Json.Serialize(TempData["ReviewSuccess"])},'success')"); }
            if (TempData["Error"] is not null) { toasts.Add($"showToast({Json.Serialize(TempData["Error"])},'error')"); }
        }
        @if (toasts.Count > 0)
        {
            <text>document.addEventListener('DOMContentLoaded', function() { @Html.Raw(string.Join(";", toasts)) });</text>
        }
    </script>

</body>