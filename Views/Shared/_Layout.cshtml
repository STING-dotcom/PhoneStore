    </style>

    <div class="page-transition-overlay" id="pageTransitionOverlay"></div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // === DROPDOWN CHEVRON ===
            const menuDropdown = document.getElementById('headerCyberMenu');
            if (menuDropdown) {
                menuDropdown.addEventListener('show.bs.dropdown', function () {
                    const icon = this.querySelector('.chevron-rotate');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                });
                menuDropdown.addEventListener('hide.bs.dropdown', function () {
                    const icon = this.querySelector('.chevron-rotate');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                });
            }

            // ==== 1. BLUE CIRCUIT BACKGROUND (NÂNG CẤP) ====
            const canvas = document.getElementById('circuitCanvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let width = canvas.width = window.innerWidth;
                let height = canvas.height = window.innerHeight;
                window.addEventListener('resize', () => {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                });

                const lineCount = 28;
                const lines = [];
                const nodes = [];

                class CircuitLine {
                    constructor() { this.reset(); }
                    reset() {
                        this.points = [];
                        let x = Math.random() * width;
                        let y = Math.random() * height;
                        this.points.push({ x, y });

                        const segments = 4 + Math.floor(Math.random() * 5);
                        for (let i = 0; i < segments; i++) {
                            const dir = Math.floor(Math.random() * 4);
                            const len = 50 + Math.random() * 120;
                            if (dir === 0) x += len;
                            else if (dir === 1) x -= len;
                            else if (dir === 2) y += len;
                            else y -= len;
                            this.points.push({ x, y });
                            // Thêm node tại mỗi điểm giao
                            if (i > 0 && Math.random() > 0.4) {
                                nodes.push({ x: this.points[i].x, y: this.points[i].y, size: 2 + Math.random() * 3, alpha: 0.2 + Math.random() * 0.3 });
                            }
                        }
                        this.leds = [];
                        const ledCount = 2 + Math.floor(Math.random() * 3);
                        for (let i = 0; i < ledCount; i++) {
                            this.leds.push({
                                progress: Math.random(),
                                speed: 0.0015 + Math.random() * 0.0035,
                                color: Math.random() > 0.5 ? '#3b82f6' : (Math.random() > 0.5 ? '#60a5fa' : '#93c5fd')
                            });
                        }
                    }
                    draw() {
                        if (this.points.length < 2) return;
                        ctx.beginPath();
                        ctx.moveTo(this.points[0].x, this.points[0].y);
                        for (let i = 1; i < this.points.length; i++) {
                            // Vẽ góc vuông (L-shape) thay vì đường chéo
                            const prev = this.points[i - 1];
                            const curr = this.points[i];
                            if (Math.random() > 0.5) {
                                ctx.lineTo(curr.x, prev.y);
                                ctx.lineTo(curr.x, curr.y);
                            } else {
                                ctx.lineTo(prev.x, curr.y);
                                ctx.lineTo(curr.x, curr.y);
                            }
                        }
                        ctx.strokeStyle = "rgba(59, 130, 246, 0.12)";
                        ctx.lineWidth = 1.8;
                        ctx.stroke();
                        // Vẽ lớp phát sáng mờ
                        ctx.beginPath();
                        ctx.moveTo(this.points[0].x, this.points[0].y);
                        for (let i = 1; i < this.points.length; i++) {
                            const prev = this.points[i - 1];
                            const curr = this.points[i];
                            if (Math.random() > 0.5) {
                                ctx.lineTo(curr.x, prev.y);
                                ctx.lineTo(curr.x, curr.y);
                            } else {
                                ctx.lineTo(prev.x, curr.y);
                                ctx.lineTo(curr.x, curr.y);
                            }
                        }
                        ctx.strokeStyle = "rgba(59, 130, 246, 0.03)";
                        ctx.lineWidth = 6;
                        ctx.stroke();
                    }
                    drawLEDs() {
                        for (let l = 0; l < this.leds.length; l++) {
                            const led = this.leds[l];
                            led.progress += led.speed;
                            if (led.progress >= 1) { led.progress = 0; continue; }
                            const totalSegments = this.points.length - 1;
                            const seg = Math.floor(led.progress * totalSegments);
                            const segP = (led.progress * totalSegments) - seg;
                            const p1 = this.points[seg];
                            const p2 = this.points[seg + 1];
                            if (!p1 || !p2) continue;
                            // Tính theo đường L-shape
                            const midX = p2.x;
                            const midY = p1.y;
                            const totalLen = Math.abs(p2.x - p1.x) + Math.abs(p2.y - p1.y);
                            const progressAlong = segP * totalLen;
                            let cx, cy;
                            const horizLen = Math.abs(p2.x - p1.x);
                            if (progressAlong <= horizLen) {
                                cx = p1.x + (p2.x > p1.x ? 1 : -1) * progressAlong;
                                cy = p1.y;
                            } else {
                                cx = p2.x;
                                cy = p1.y + (p2.y > p1.y ? 1 : -1) * (progressAlong - horizLen);
                            }

                            ctx.shadowBlur = 18;
                            ctx.shadowColor = led.color;
                            ctx.beginPath();
                            ctx.arc(cx, cy, 2.5, 0, Math.PI * 2);
                            ctx.fillStyle = led.color;
                            ctx.fill();

                            // Đuôi sáng
                            ctx.shadowBlur = 0;
                            ctx.beginPath();
                            ctx.arc(cx, cy, 5, 0, Math.PI * 2);
                            ctx.fillStyle = this.hexToRgba(led.color, 0.15);
                            ctx.fill();
                        }
                        ctx.shadowBlur = 0;
                    }
                    hexToRgba(hex, alpha) {
                        const r = parseInt(hex.slice(1, 3), 16);
                        const g = parseInt(hex.slice(3, 5), 16);
                        const b = parseInt(hex.slice(5, 7), 16);
                        return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
                    }
                }

                for (let i = 0; i < lineCount; i++) { lines.push(new CircuitLine()); }

                function animate() {
                    ctx.clearRect(0, 0, width, height);
                    // Vẽ node
                    for (let n = 0; n < nodes.length; n++) {
                        const node = nodes[n];
                        ctx.shadowBlur = 8;
                        ctx.shadowColor = '#3b82f6';
                        ctx.beginPath();
                        ctx.arc(node.x, node.y, node.size, 0, Math.PI * 2);
                        ctx.fillStyle = 'rgba(59, 130, 246, ' + node.alpha + ')';
                        ctx.fill();
                        ctx.shadowBlur = 0;
                    }
                    for (let i = 0; i < lines.length; i++) {
                        lines[i].draw();
                        lines[i].drawLEDs();
                    }
                    requestAnimationFrame(animate);
                }
                animate();
            }

            // ==== 2. SCROLL MAGIC ANIMATION NÂNG CẤP ====
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.06, rootMargin: '0px 0px -30px 0px' });

                document.querySelectorAll('.magic-fade-up, .magic-fade-left, .magic-fade-right, .magic-scale-in, .product-card-stagger').forEach(el => {
                    observer.observe(el);
                });

                // Observe product cards, sections, cards tự động
                document.querySelectorAll('.product-card-custom, .cyber-product-card, .card, .section-flashsale, .section-new-releases, .section-trending, .cyber-filter-card, .checkout-wrapper, .cart-wrapper, .order-success-wrapper, .invoice-wrapper, .wallet-card, .topup-wrapper, [class*="section-"], .aurora-box, .admin-stat-card, .admin-quick-link, .sec-card').forEach(el => {
                    if (!el.classList.contains('magic-fade-up') && !el.classList.contains('magic-fade-left') && !el.classList.contains('magic-fade-right') && !el.classList.contains('magic-scale-in') && !el.classList.contains('product-card-stagger')) {
                        el.classList.add('magic-fade-up');
                        observer.observe(el);
                    }
                });

                // Stagger product cards in grid
                var staggerCards = document.querySelectorAll('.product-card-stagger');
                staggerCards.forEach(function(el, i) {
                    el.style.animationDelay = (i * 0.06) + 's';
                });
            }

            // ==== 3. CLICK RIPPLE EFFECT ====
            document.addEventListener('click', function (e) {
                const target = e.target.closest('a, button, .btn, .list-group-item, .page-link, .payment-option, .method-card, .amount-chip');
                if (!target) return;
                const ripple = document.createElement('div');
                ripple.className = 'magic-ripple';
                const size = Math.max(target.offsetWidth, target.offsetHeight) * 0.6;
                const rect = target.getBoundingClientRect();
                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
                target.style.position = 'relative';
                target.style.overflow = 'hidden';
                target.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });

            // ==== 4. PAGE TRANSITION FADE ====
            const overlay = document.getElementById('pageTransitionOverlay');
            if (overlay) {
                document.querySelectorAll('a:not([target="_blank"]):not([href^="#"]):not([href^="javascript"]):not([href^="tel"]):not([href^="mailto"])').forEach(function (link) {
                    link.addEventListener('click', function (e) {
                        if (this.hostname === window.location.hostname && this.getAttribute('href') !== '#') {
                            overlay.style.setProperty('--x', e.clientX / window.innerWidth * 100 + '%');
                            overlay.style.setProperty('--y', e.clientY / window.innerWidth * 100 + '%');
                            overlay.classList.add('active');
                        }
                    });
                });
                window.addEventListener('pageshow', function () { overlay.classList.remove('active'); });
            }

            // ==== 5. HOVER CYBER GLOW ====
