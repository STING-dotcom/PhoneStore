                        <div class="card h-100 product-card-custom shadow-sm position-relative">
                            <span class="position-absolute top-0 start-0 badge bg-success m-3 px-2.5 py-1.5 shadow-sm fw-bold" style="border-radius: 8px; z-index: 2;">Hot</span>
                            <img src="@product.ImageUrl" class="card-img-top img-fluid" alt="@product.Name" style="object-fit: contain; height: 160px; padding: 15px;">
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title fw-bold text-truncate mb-1" title="@product.Name">@product.Name</h6>
                                <div class="d-flex gap-2 mb-1 small">
                                    <span class="text-info fw-semibold" style="font-size: 0.7rem;"><i class="fa-solid fa-chart-simple"></i> Đã bán: @ProductController.GetPurchaseCount(product.Id)</span>
                                    @{
                                        var trendAvg = ViewBag.AvgRatings?.ContainsKey(product.Id) == true ? ViewBag.AvgRatings[product.Id] : 0;
                                        var trendRevCount = ViewBag.ReviewCounts?.ContainsKey(product.Id) == true ? ViewBag.ReviewCounts[product.Id] : 0;
                                    }
                                    @if (trendRevCount > 0)
                                    {
                                        <span class="text-warning fw-semibold" style="font-size: 0.7rem;"><i class="fa-solid fa-star"></i> @trendAvg</span>
                                    }
                                </div>
                                <p class="card-text text-muted small text-truncate-2 flex-grow-1 mb-3" style="font-size: 0.8rem; line-height: 1.4;">@product.Description</p>
                                <div class="mt-auto">
                                    <div class="d-flex align-items-center mb-3">
                                        <span class="price-new" style="font-size: 1.15rem;">@product.Price.ToString("N0")đ</span>
                                    </div>
                                    <a href="/Product/Details/@product.Id" class="btn-view-custom btn-view-trending">Xem Chi Tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        function setupCarouselLogic(containerId, itemClass, prevBtnId, nextBtnId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const items = container.querySelectorAll(`.${itemClass}`);
            if (items.length === 0) return;

            let currentIndex = 0;
            const getItemsPerPage = () => window.innerWidth >= 768 ? 5 : 2;

            function updateCarousel() {
                const itemsPerPage = getItemsPerPage();
                items.forEach((item, index) => {
                    if (index >= currentIndex && index < currentIndex + itemsPerPage) {
                        item.style.display = "block";
                        item.classList.add("magic-reveal-active");
                    } else {
                        item.style.display = "none";
                        item.classList.remove("magic-reveal-active");
                    }
                });
                const prevBtn = document.getElementById(prevBtnId);
                const nextBtn = document.getElementById(nextBtnId);
                if (prevBtn) prevBtn.disabled = currentIndex === 0;
                if (nextBtn) nextBtn.disabled = currentIndex + itemsPerPage >= items.length;
            }

            const prevBtn = document.getElementById(prevBtnId);
            const nextBtn = document.getElementById(nextBtnId);

            if (prevBtn) {
                prevBtn.addEventListener("click", () => {
                    if (currentIndex > 0) {
                        currentIndex -= 1;
                        updateCarousel();
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener("click", () => {
                    const itemsPerPage = getItemsPerPage();
                    if (currentIndex + itemsPerPage < items.length) {
                        currentIndex += 1;
                        updateCarousel();
                    }
                });
            }

            updateCarousel();
            window.addEventListener("resize", updateCarousel);
        }

        setupCarouselLogic("flashSaleContainer", "product-item-flash", "prevFlashBtn", "nextFlashBtn");
        setupCarouselLogic("newProductsContainer", "product-item-new", "prevNewBtn", "nextNewBtn");
        setupCarouselLogic("trendingProductsContainer", "product-item-trending", "prevTrendBtn", "nextTrendBtn");

        function startFlashSaleCountdown() {
            const countdownEl = document.getElementById("flashSaleCountdown");
            if (!countdownEl) return;

            function refreshClock() {
                const now = new Date();
                const endOfToday = new Date();
                endOfToday.setHours(23, 59, 59, 0);

                let timeDiff = endOfToday - now;
                if (timeDiff <= 0) {
                    timeDiff = 3 * 60 * 60 * 1000;
                }

                const hrs = Math.floor(timeDiff / (1000 * 60 * 60));
                const mins = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
                const secs = Math.floor((timeDiff % (1000 * 60)) / 1000);

                const hrsStr = hrs.toString().padStart(2, '0');
                const minsStr = mins.toString().padStart(2, '0');
                const secsStr = secs.toString().padStart(2, '0');

                countdownEl.innerHTML = `<span class="badge bg-danger px-2 py-1 mx-0.5">${hrsStr}</span>:<span class="badge bg-danger px-2 py-1 mx-0.5">${minsStr}</span>:<span class="badge bg-danger px-2 py-1 mx-0.5">${secsStr}</span>`;
            }

            refreshClock();
            setInterval(refreshClock, 1000);
        }
        startFlashSaleCountdown();

        // ==== 3D HERO BANNER ====
        var heroCards = document.querySelectorAll('.hero-3d-card');
        var heroDots = document.querySelectorAll('.hero-3d-dots .dot');
        var heroTitle = document.getElementById('heroSlideTitle');
        var heroDesc = document.getElementById('heroSlideDesc');
        var showcase = document.getElementById('hero3dShowcase');
        var content = document.getElementById('hero3dContent');
        var badgeText = document.getElementById('heroBadgeText');
        var currentSlide = 0;
        var slideInterval;
        var slideData = [
            { badge: 'KHO SẢN PHẨM 2026', title: 'KHO SẢN PHẨM<br><span class="gradient-text">ĐA DẠNG &amp; CHẤT LƯỢNG</span>', desc: 'Hơn 151 mẫu điện thoại từ các thương hiệu hàng đầu: Apple, Samsung, Xiaomi, OPPO, Sony, Nokia và nhiều hãng khác.' },
            { badge: 'CHÍNH SÁCH MINH BẠCH', title: 'CHÍNH SÁCH<br><span class="gradient-text-orange">MINH BẠCH &amp; UY TÍN</span>', desc: 'Bảo hành chính hãng 12-24 tháng, đổi trả 30 ngày miễn phí, giao hỏa tốc trong 2h, trợ giá thu cũ lên tới 2 triệu đồng.' },
            { badge: 'BẢO MẬT TOÀN DIỆN', title: 'BẢO MẬT<br><span class="gradient-text-green">TOÀN DIỆN &amp; AN TOÀN</span>', desc: 'Cookie authentication an toàn, mã hóa mật khẩu PBKDF2, phân quyền Admin/User, chống CSRF, HTTPS toàn trình với chứng chỉ SSL.' }
        ];

        function goToSlide(index) {
            if (index === currentSlide) return;
            heroCards.forEach(function(c, i) {
                c.classList.toggle('active', i === index);
            });
            heroDots.forEach(function(d, i) {
                d.classList.toggle('active', i === index);
            });
            heroTitle.innerHTML = slideData[index].title;
            heroDesc.textContent = slideData[index].desc;
            badgeText.textContent = slideData[index].badge;
            currentSlide = index;
        }

        function nextSlide() { goToSlide((currentSlide + 1) % heroCards.length); }

        function startAutoSlide() {
            slideInterval = setInterval(nextSlide, 4200);
        }
        function resetAutoSlide() {
            clearInterval(slideInterval); startAutoSlide();
        }

        heroDots.forEach(function(dot) {
            dot.addEventListener('click', function() {
                goToSlide(parseInt(this.dataset.index));
                resetAutoSlide();
            });
        });

        if (heroCards.length > 0) startAutoSlide();

        // 3D Mouse Parallax Tilt
        if (showcase) {
            showcase.addEventListener('mousemove', function(e) {
                var rect = showcase.getBoundingClientRect();
                var x = (e.clientX - rect.left) / rect.width - 0.5;
                var y = (e.clientY - rect.top) / rect.height - 0.5;
                showcase.style.transform = 'rotateY(' + (x * 12) + 'deg) rotateX(' + (-y * 12) + 'deg) translateZ(10px)';
                if (content) {
                    content.style.transform = 'rotateY(' + (x * 6) + 'deg) rotateX(' + (-y * 6) + 'deg) translateZ(5px)';
                }
            });
            showcase.addEventListener('mouseleave', function() {
                showcase.style.transform = 'rotateY(0deg) rotateX(0deg) translateZ(0)';
                if (content) content.style.transform = 'rotateY(0deg) rotateX(0deg) translateZ(0)';
            });
        }

        // Floating particles
        var wrapper = document.querySelector('.hero-3d-wrapper');
        if (wrapper) {
            var colors = ['rgba(59,130,246,0.3)', 'rgba(139,92,246,0.25)', 'rgba(16,185,129,0.2)', 'rgba(238,9,121,0.2)'];
            for (var p = 0; p < 20; p++) {
                var particle = document.createElement('div');
                particle.className = 'hero-particle';
                var size = 3 + Math.random() * 7;
                var color = colors[Math.floor(Math.random() * colors.length)];
                particle.style.cssText = 'width:' + size + 'px;height:' + size + 'px;background:' + color + ';left:' + (Math.random() * 100) + '%;top:' + (Math.random() * 100) + '%;animation:particleFloat ' + (4 + Math.random() * 6) + 's infinite ' + (Math.random() * 4) + 's ease-in-out;';
                wrapper.appendChild(particle);
            }
        }
    });
</script>